---
import Breadcrumb from './Breadcrumb.astro';

interface Crumb { label: string; href?: string; }

interface Props {
  title: string;
  subtitle?: string;
  crumbs?: Crumb[];
  ghost?: string;
}

const { title, subtitle, crumbs, ghost = title } = Astro.props;
---

<header class="bg-gradient-to-br from-custom-light-grey via-custom-light-grey to-custom-purple pt-32 pb-20 text-center">
  <div class="container-wide">
    {crumbs && crumbs.length > 0 && <Breadcrumb crumbs={crumbs} />}

    <div class="relative text-center mb-8" data-reveal>
      <span
        class="absolute inset-0 flex items-center justify-center text-6xl md:text-9xl font-bold text-custom-purple opacity-20 select-none uppercase tracking-widest pointer-events-none font-titles"
        aria-hidden="true"
      >{ghost}</span>
      <h1 class="relative z-10 text-4xl md:text-5xl font-bold text-custom-black font-titles">{title}</h1>
    </div>

    {subtitle && (
      <p class="text-xl text-custom-dark-gray max-w-3xl mx-auto" data-reveal data-reveal-delay="120">
        {subtitle}
      </p>
    )}

    <slot />
  </div>
</header>
