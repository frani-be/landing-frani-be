---
import '../styles/global.css';
import ContactSection from '../components/ContactSection.astro';
import EmbroideryPattern from '../components/EmbroideryPattern.astro';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
}

const {
  title,
  description = 'Portafolio de Francisca Medina (Frani): diseño UX estratégico, desarrollo front-end, charlas tech y mentorías STEAM desde Chile.',
  ogImage = 'https://frani.be/images/logo.jpg',
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? 'https://frani.be').href;

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': 'https://frani.be/#persona',
      name: 'Francisca Beatriz Medina Concha',
      alternateName: 'Frani Medina',
      url: 'https://frani.be/',
      image: 'https://frani.be/images/frani.png',
      jobTitle: 'Diseñadora UX Estratégica y Front-End Engineer',
      description,
      email: 'mailto:hola@frani.be',
      nationality: { '@type': 'Country', name: 'Chile' },
      knowsAbout: [
        'UX Design', 'Front-End Development', 'Estrategia de producto digital',
        'Diseño gráfico', 'Docencia en tecnología', 'Comunidades STEAM',
      ],
      sameAs: [
        'https://www.linkedin.com/in/frani-be/',
        'https://github.com/frani-be',
        'https://www.instagram.com/frani.be/',
      ],
    },
    {
      '@type': 'WebSite',
      '@id': 'https://frani.be/#sitio',
      url: 'https://frani.be/',
      name: 'frani.be',
      inLanguage: 'es-CL',
      publisher: { '@id': 'https://frani.be/#persona' },
    },
    {
      '@type': 'WebPage',
      url: canonicalUrl,
      name: title,
      description,
      inLanguage: 'es-CL',
      isPartOf: { '@id': 'https://frani.be/#sitio' },
    },
  ],
};
---

<!doctype html>
<html lang="es" class="overflow-x-hidden">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="author" content="Francisca Beatriz Medina Concha" />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_CL" />
    <meta property="og:site_name" content="frani.be" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content="Francisca Medina (Frani), diseñadora UX estratégica y front-end" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Datos estructurados -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <!-- Tema: aplicar clase antes del primer paint para evitar FOUC -->
    <script is:inline>
      (function () {
        var t = localStorage.getItem('theme');
        if (t === 'dark' || (!t && matchMedia('(prefers-color-scheme: dark)').matches)) {
          document.documentElement.classList.add('dark');
        }
      })();
    </script>

    <!-- Favicons -->
    <link href="/favicons/apple-touch-icon-76x76.png" rel="apple-touch-icon" sizes="76x76" />
    <link href="/favicons/apple-touch-icon-120x120.png" rel="apple-touch-icon" sizes="120x120" />
    <link href="/favicons/apple-touch-icon-152x152.png" rel="apple-touch-icon" sizes="152x152" />
    <link href="/favicons/apple-touch-icon-180x180.png" rel="apple-touch-icon" sizes="180x180" />
    <link href="/favicons/icon-hires.png" rel="icon" sizes="192x192" />
    <link href="/favicons/icon-normal.png" rel="icon" sizes="128x128" />
    <link href="/favicons/icon.svg" rel="mask-icon" sizes="any" />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,100..1000;1,9..40,100..1000&family=JetBrains+Mono:wght@400;500&family=Space+Grotesk:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <slot name="head" />
  </head>

  <body class="overflow-x-hidden font-primary font-light text-custom-black text-base lg:text-lg">
    <a href="#contenido" class="skip-link">Saltar al contenido</a>
    <!-- Navigation -->
    <nav class="fixed top-0 left-1/2 -translate-x-1/2 w-full py-4 pb-6 z-[3] overflow-visible" id="navigation">
      <div class="w-full px-8 mx-auto max-w-[540px] sm:max-w-[722px] md:max-w-[900px] lg:max-w-[1220px] xl:max-w-[1380px] flex items-center justify-between gap-6">
        <div class="logo-container">
          <a href="/" aria-label="Ir al inicio">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 300 70.3">
              <use href="/images/icons.svg#logo"></use>
            </svg>
          </a>
        </div>
        <div class="hidden md:flex items-center gap-1">
          <a href="/trayectoria" class="nav-link">Trayectoria</a>
          <a href="/servicios" class="nav-link">Servicios</a>
          <a href="/proyectos" class="nav-link">Proyectos</a>
          <a href="#contacto" class="btn btn-primary ml-2" style="padding:0.55rem 1.4rem">Contacto</a>
        </div>
        <button
          id="theme-toggle"
          class="flex items-center justify-center w-10 h-10 rounded-full text-custom-dark-gray hover:text-custom-purple hover:bg-custom-purple/10 transition-all"
          aria-label="Cambiar entre tema claro y oscuro"
        >
          <svg class="icon-moon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" />
          </svg>
          <svg class="icon-sun hidden" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
          </svg>
        </button>
        <button
          id="nav-toggle"
          class="md:hidden flex items-center justify-center w-10 h-10 rounded-full text-custom-dark-gray hover:text-custom-purple hover:bg-custom-purple/10 transition-all"
          aria-expanded="false"
          aria-controls="nav-mobile"
          aria-label="Abrir menú de navegación"
        >
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
            <path class="nav-icon-open" d="M4 7h16M4 12h16M4 17h16" />
            <path class="nav-icon-close hidden" d="M6 6l12 12M18 6L6 18" />
          </svg>
        </button>
      </div>
      <div id="nav-mobile" class="md:hidden hidden px-8 pb-4">
        <div class="flex flex-col gap-1 bg-surface/90 rounded-[var(--radius-card)] border border-border-soft shadow-lg p-3">
          <a href="/trayectoria" class="nav-link">Trayectoria</a>
          <a href="/servicios" class="nav-link">Servicios</a>
          <a href="/proyectos" class="nav-link">Proyectos</a>
          <a href="#contacto" class="btn btn-primary mt-2" style="padding:0.6rem 1.4rem">Contacto</a>
        </div>
      </div>
    </nav>

    <main id="contenido">
      <slot />
      <ContactSection />
    </main>

    <!-- Footer -->
    <footer class="py-8 bg-gradient-footer text-white relative overflow-hidden">
      <div class="container-wide text-center relative z-[1]">
        <EmbroideryPattern class="embroidery--light mx-auto mb-5" cells={4} />
        <p class="text-[0.75em] opacity-90">
          © <span id="current-year"></span> frani.be
        </p>
        <p class="site-signature">// hecho con código, curiosidad y té</p>
      </div>
    </footer>

    <script>
      import { initSpotlight } from '../scripts/spotlight';
      initSpotlight();

      document.getElementById('current-year')!.textContent = String(new Date().getFullYear());

      const navToggle = document.getElementById('nav-toggle');
      const navMobile = document.getElementById('nav-mobile');
      const nav = document.getElementById('navigation');
      const setNavOpen = (open: boolean) => {
        navMobile?.classList.toggle('hidden', !open);
        nav?.classList.toggle('nav-open', open);
        navToggle?.setAttribute('aria-expanded', String(open));
        navToggle?.setAttribute('aria-label', open ? 'Cerrar menú de navegación' : 'Abrir menú de navegación');
        navToggle?.querySelector('.nav-icon-open')?.classList.toggle('hidden', open);
        navToggle?.querySelector('.nav-icon-close')?.classList.toggle('hidden', !open);
      };
      navToggle?.addEventListener('click', () => setNavOpen(navMobile?.classList.contains('hidden') ?? false));
      navMobile?.querySelectorAll('a').forEach(link => {
        link.addEventListener('click', () => setNavOpen(false));
      });
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && navMobile && !navMobile.classList.contains('hidden')) {
          setNavOpen(false);
          navToggle?.focus();
        }
      });

      // Tema claro/oscuro
      const themeToggle = document.getElementById('theme-toggle');
      const syncThemeIcon = () => {
        const dark = document.documentElement.classList.contains('dark');
        themeToggle?.querySelector('.icon-moon')?.classList.toggle('hidden', dark);
        themeToggle?.querySelector('.icon-sun')?.classList.toggle('hidden', !dark);
      };
      syncThemeIcon();
      themeToggle?.addEventListener('click', () => {
        const dark = document.documentElement.classList.toggle('dark');
        localStorage.setItem('theme', dark ? 'dark' : 'light');
        syncThemeIcon();
      });
    </script>
  </body>
</html>
