---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import LinksModal from '../../components/LinksModal.astro';
---

<BaseLayout
  title="Portafolio Completo | Francisca Beatriz Medina Concha"
  description="Explora mi portafolio completo de proyectos en UX Design y Front-End Development."
  ogUrl="https://frani.be/proyectos"
>
  <PageHero
    title="Portafolio Completo"
    ghost="Portafolio"
    subtitle="Explora mi trabajo en diseño UX, desarrollo front-end y proyectos de impacto social."
    crumbs={[{ label: 'Inicio', href: '/' }, { label: 'Portafolio' }]}
  />

  <section class="py-20 bg-custom-light-grey">
    <div class="container-wide">
      <div id="all-projects-container" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8"></div>
    </div>
  </section>

  <LinksModal />
</BaseLayout>

<script>
  import { initReveal } from '../../scripts/reveal';
  import { buildProjectCardHTML, extractYear, initLinksModal, revealProjectCards, type Project } from '../../scripts/projects';
  initReveal();

  async function initProjects() {
    const res = await fetch('/data/projects.json');
    const data = await res.json();
    let projects: Project[] = data.projects || [];
    projects.sort((a, b) => extractYear(b.date ?? '') - extractYear(a.date ?? ''));

    const container = document.getElementById('all-projects-container');
    if (!container) return;
    container.innerHTML = projects.map(buildProjectCardHTML).join('');

    revealProjectCards();
    initLinksModal(projects);
  }

  initProjects();
</script>
