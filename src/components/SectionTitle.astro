---
interface Props {
  title: string;
  subtitle?: string;
  tag?: string;
  class?: string;
  reveal?: boolean;
  dark?: boolean;
}

const {
  title,
  subtitle,
  tag,
  class: extraClass = '',
  reveal = true,
  dark = false,
} = Astro.props;
---

<div
  class:list={['section-title-wrapper', extraClass]}
  data-reveal={reveal || undefined}
>
  {tag && <span class:list={['section-tag', dark && 'section-tag--dark']}>{tag}</span>}
  <h3 class:list={['section-title-front', dark && 'section-title-front--dark']}>{title}</h3>
  {subtitle && (
    <p class:list={['section-title-subtitle', dark && 'section-title-subtitle--dark']}>{subtitle}</p>
  )}
</div>
