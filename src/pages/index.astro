            <li>
              <a href="https://www.linkedin.com/in/frani-be/" class="flex items-center gap-3 text-white font-semibold hover:text-custom-light-purple transition-colors" target="_blank" rel="noopener noreferrer">
                <span class="contact-icon-pill"><svg class="inline" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 400 400"><use href="/images/icons.svg#linkedin"></use></svg></span>
                LinkedIn
