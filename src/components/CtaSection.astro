---
import { t, type Lang } from '../i18n/ui';

interface Props {
  title?: string;
  subtitle?: string;
  primaryLabel?: string;
  primaryHref?: string;
  secondaryLabel?: string;
  secondaryHref?: string;
  bg?: string;
  lang?: Lang;
}

const {
  lang = 'es',
  title = lang === 'en' ? "Let's talk about your next project" : 'Hablemos de tu próximo proyecto',
  subtitle,
  primaryLabel = t(lang, 'contact.call'),
  primaryHref = 'https://calendar.app.google/NjSZEbvWrLfj56wy6',
  secondaryLabel,
  secondaryHref,
  bg = 'bg-surface',
} = Astro.props;
---

<section class:list={['section-block-sm', bg]}>
  <div class="container-narrow text-center">
    <h2 class="text-3xl md:text-4xl text-custom-black mb-4" data-reveal>{title}</h2>
    {subtitle && (
      <p class="text-xl text-custom-dark-gray mb-8 max-w-2xl mx-auto" data-reveal data-reveal-delay="100">{subtitle}</p>
    )}
    <div class="flex flex-col sm:flex-row gap-4 justify-center" data-reveal data-reveal-delay="200">
      <a
        href={primaryHref}
        target={primaryHref.startsWith('http') ? '_blank' : undefined}
        rel={primaryHref.startsWith('http') ? 'noopener noreferrer' : undefined}
        class="btn btn-primary"
      >{primaryLabel}</a>
      {secondaryLabel && secondaryHref && (
        <a
          href={secondaryHref}
          class="btn btn-secondary"
        >{secondaryLabel}</a>
      )}
    </div>
  </div>
</section>
