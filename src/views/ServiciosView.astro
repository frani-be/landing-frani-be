---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import CtaSection from '../components/CtaSection.astro';
import ArrowIcon from '../components/ArrowIcon.astro';
import EmbroideryPattern from '../components/EmbroideryPattern.astro';
import { serviceIcons, secondaryIcons } from '../scripts/serviceIcons';
import { localePath, type Lang } from '../i18n/ui';

interface Props { lang: Lang; }
const { lang } = Astro.props;

const copy = {
  es: {
    title: 'Servicios de Diseño UX y Desarrollo Web | Frani Medina',
    description: 'Desarrollo web, diseño gráfico, estrategia UX y clases particulares ofrecidos por Francisca Medina: diseño y código en una sola persona.',
    heroTitle: 'Diseño, código y estrategia en una sola persona',
    heroSub: 'Cuatro servicios clave: lanza tu sitio, haz única tu marca, ordena tu producto o aprende a tu ritmo.',
    heroCta: 'Explorar servicios',
    mainTitle: 'Servicios principales',
    secondaryTitle: 'También puedo ayudarte con…',
    details: 'Ver detalles',
    ctaTitle: '¿Listo/a para empezar?',
    ctaSub: 'Agendemos una videollamada sin compromiso.',
    processTag: '// proceso',
    processTitle: 'Cómo es trabajar conmigo',
    processSub: 'El mismo proceso claro para todo proyecto: transparencia de la primera llamada a la entrega.',
    process: [
      { title: 'Videollamada inicial', desc: 'Me cuentas tu idea, objetivos y contexto. Sin costo ni compromiso.' },
      { title: 'Discovery', desc: 'Investigo contexto, usuarios y competencia para definir el alcance real.' },
      { title: 'Propuesta cerrada', desc: 'Entregables, tiempos y presupuesto concretos. Sin sorpresas.' },
      { title: 'Diseño y desarrollo', desc: 'Iteramos con entregas parciales y feedback continuo hasta dar con la solución.' },
      { title: 'Entrega y lanzamiento', desc: 'Archivos, handoff y soporte post-entrega incluidos.' },
    ],
    principales: [
      { slug: 'desarrollo-web', title: 'Lanza tu sitio web', short: 'Tu sitio completo, rápido y autogestionable. De la idea al aire.' },
      { slug: 'diseno-grafico', title: 'Haz única tu marca', short: 'Logo, paleta y piezas coherentes que hablan el mismo idioma en todo canal.' },
      { slug: 'estrategia-ux', title: 'Ordena tu producto', short: 'UX con evidencia: research, prototipos y tests que hacen fluir tu producto.' },
      { slug: 'clases-particulares', title: 'Aprende a tu ritmo', short: 'Clases 1 a 1 de diseño, UX o front-end, con proyectos reales y feedback directo.' },
    ],
    secundarios: [
      { icon: 'auditoria-cro-seo', title: 'Auditoría CRO, SEO y GEO', short: 'Análisis para mejorar tu conversión y tu visibilidad en buscadores e IA.' },
      { icon: 'asesorias-personales', title: 'Asesorías personales', short: 'Orientación para profesionales y emprendedores que se adentran al mundo tech.' },
      { icon: 'ugc', title: 'UGC', short: 'Contenido generado por usuarios para marcas y campañas en redes.' },
      { icon: 'mentorias-charlas', title: 'Mentorías para charlas', short: 'Estructura y ensayo de tu presentación para llegar con confianza al escenario.' },
      { icon: 'apoyo-freelance', title: 'Apoyo freelance', short: 'Refuerzo técnico o de diseño para agencias y equipos en proyectos puntuales.' },
      { icon: 'generacion-contenido', title: 'Generación de contenido', short: 'Copywriting UX, artículos y newsletters con comunicación clara y accionable.' },
    ],
  },
  en: {
    title: 'UX Design & Web Development Services | Frani Medina',
    description: 'Web development, graphic design, UX strategy and private classes by Francisca Medina: design and code in one person.',
    heroTitle: 'Design, code and strategy in one person',
    heroSub: 'Four core services: launch your site, make your brand unique, streamline your product or learn at your own pace.',
    heroCta: 'Explore services',
    mainTitle: 'Main services',
    secondaryTitle: 'I can also help you with…',
    details: 'View details',
    ctaTitle: 'Ready to start?',
    ctaSub: "Let's book a free call to talk about your project.",
    processTag: '// process',
    processTitle: 'What working with me looks like',
    processSub: 'The same clear process for any project: transparency from kickoff to delivery.',
    process: [
      { title: 'Kickoff call', desc: 'Tell me your idea, goals and context. Free, no strings attached.' },
      { title: 'Discovery', desc: 'I research context, users and competitors to define the real scope.' },
      { title: 'Fixed-scope proposal', desc: 'Concrete deliverables, timeline and budget. No surprises.' },
      { title: 'Design & build', desc: 'We iterate with partial deliveries and continuous feedback until we nail it.' },
      { title: 'Delivery & launch', desc: 'Files, handoff and post-delivery support included.' },
    ],
    principales: [
      { slug: 'desarrollo-web', title: 'Launch your website', short: 'Your full site, fast and self-manageable. From idea to launch.' },
      { slug: 'diseno-grafico', title: 'Make your brand unique', short: 'Logo, palette and consistent assets that speak the same language everywhere.' },
      { slug: 'estrategia-ux', title: 'Streamline your product', short: 'Evidence-backed UX: research, prototypes and tests that make your product flow.' },
      { slug: 'clases-particulares', title: 'Learn at your own pace', short: '1-on-1 design, UX or front-end classes with real projects and direct feedback.' },
    ],
    secundarios: [
      { icon: 'auditoria-cro-seo', title: 'CRO, SEO & GEO audit', short: 'Analysis to improve conversion and visibility in search engines and AI.' },
      { icon: 'asesorias-personales', title: '1-on-1 consulting', short: 'Guidance for professionals and entrepreneurs entering tech.' },
      { icon: 'ugc', title: 'UGC', short: 'User-generated content for brands and social campaigns.' },
      { icon: 'mentorias-charlas', title: 'Speaking coaching', short: 'Structure and rehearsal for your talk, so you hit the stage with confidence.' },
      { icon: 'apoyo-freelance', title: 'Freelance support', short: 'Technical or design reinforcement for agencies and teams on specific projects.' },
      { icon: 'generacion-contenido', title: 'Content creation', short: 'UX copywriting, articles and newsletters with a clear, actionable voice.' },
    ],
  },
}[lang];

const icon = (paths: string) =>
  `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${paths}</svg>`;

const stepIcons = [
  icon('<path d="m22 8-6 4 6 4V8Z"/><rect width="14" height="12" x="2" y="6" rx="2"/>'),
  icon('<circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/>'),
  icon('<path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/><path d="M14 2v4a2 2 0 0 0 2 2h4"/><path d="m9 15 2 2 4-4"/>'),
  icon('<polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/>'),
  icon('<path d="M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2c.71-.84.7-2.13-.09-2.91a2.18 2.18 0 0 0-2.91-.09z"/><path d="m12 15-3-3a22 22 0 0 1 2-3.95A12.88 12.88 0 0 1 22 2c0 2.72-.78 7.5-6 11a22.35 22.35 0 0 1-4 2z"/><path d="M9 12H4s.55-3.03 2-4c1.62-1.08 5 0 5 0"/><path d="M12 15v5s3.03-.55 4-2c1.08-1.62 0-5 0-5"/>'),
];
---

<BaseLayout
  title={copy.title}
  description={copy.description}
  lang={lang}
>
  <PageHero
    lang={lang}
    align="left"
    title={copy.heroTitle}
    path={[{ label: 'servicios' }]}
    subtitle={copy.heroSub}
    ctaLabel={copy.heroCta}
    ctaHref="#principales"
    ctaIcon="down"
  >
    <!-- Textura de bordado + stickers flotantes de todos los servicios -->
    <EmbroideryPattern class="embroidery--light hero-deco hero-deco-tl" cells={5} />
    <EmbroideryPattern class="embroidery--light hero-deco hero-deco-br" cells={4} />
    {[...Object.values(serviceIcons), ...Object.values(secondaryIcons)].map(src => (
      <img src={src} alt="" loading="lazy" aria-hidden="true" class="hero-sticker" />
    ))}
  </PageHero>

  <script>
    // Stickers del hero: cada recarga los reposiciona aleatoriamente dentro
    // de slots seguros (bordes y mitad derecha, lejos del texto)
    const heroSlots: [number, number][] = [
      [-3, 0], [8, -6], [26, -8], [44, 80], [56, 84],
      [58, 2], [66, 52], [70, 68], [74, -3], [78, 36],
      [84, 12], [88, 60], [90, 80], [-2, 52], [48, -7], [94, 40],
    ];
    const heroPool = [...heroSlots].sort(() => Math.random() - 0.5);
    document.querySelectorAll<HTMLElement>('.hero-sticker').forEach((s, i) => {
      const [x, y] = heroPool[i % heroPool.length];
      s.style.left = `${x + (Math.random() * 8 - 4)}%`;
      s.style.top = `${y + (Math.random() * 8 - 4)}%`;
      s.style.setProperty('--rot', `${Math.random() * 26 - 13}deg`);
      s.style.setProperty('--sc', (0.75 + Math.random() * 0.4).toFixed(2));
      s.style.setProperty('--float-delay', `${(Math.random() * 6).toFixed(1)}s`);
    });
  </script>

  <!-- Principales -->
  <section class="section-block-sm bg-surface scroll-mt-24" id="principales">
    <div class="container-wide">
      <h2 class="text-2xl text-custom-black mb-12 text-center" data-reveal>{copy.mainTitle}</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {copy.principales.map((s, i) => (
          <a href={localePath(`/servicios/${s.slug}`, lang)} class="service-card group" data-reveal data-reveal-delay={String(i * 100)}>
            <div class="service-card-icon"><img src={serviceIcons[s.slug as keyof typeof serviceIcons]} alt="" loading="lazy" /></div>
            <div class="p-6 flex flex-col flex-1">
              <h3 class="text-xl mb-3">{s.title}</h3>
              <p class="text-custom-dark-gray text-sm flex-1">{s.short}</p>
              <span class="service-link mt-5">{copy.details}<ArrowIcon name="upRight" class="btn-arrow" /></span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Secundarios -->
  <section class="section-block-sm bg-custom-light-grey">
    <div class="container-wide">
      <h2 class="text-2xl text-custom-black mb-12 text-center" data-reveal>{copy.secondaryTitle}</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {copy.secundarios.map((s, i) => (
          <article class="bg-surface rounded-[var(--radius-card)] border border-border-soft p-6 flex gap-5 items-start hover:shadow-md hover:border-border-hover transition-all duration-300" data-reveal data-reveal-delay={String(i * 80)}>
            <span class="icon-tile mt-1"><img src={secondaryIcons[s.icon as keyof typeof secondaryIcons]} alt="" loading="lazy" /></span>
            <div>
              <h3 class="text-lg text-custom-black mb-2">{s.title}</h3>
              <p class="text-custom-dark-gray text-sm">{s.short}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Proceso -->
  <section class="section-block-sm bg-surface scroll-mt-24" id="proceso">
    <div class="container-wide">
      <div class="text-center mb-12" data-reveal>
        <p class="section-tag mb-4">{copy.processTag}</p>
        <h2 class="text-2xl md:text-3xl text-custom-black mb-4">{copy.processTitle}</h2>
        <p class="text-custom-dark-gray max-w-2xl mx-auto">{copy.processSub}</p>
      </div>
      <ol class="process-steps grid grid-cols-1 md:grid-cols-5 gap-10 md:gap-6">
        {copy.process.map((step, i) => (
          <li class="process-step" data-reveal data-reveal-delay={String(i * 90)}>
            <div class="process-head">
              <span class="process-num">{String(i + 1).padStart(2, '0')}</span>
              <span class="process-line" aria-hidden="true"></span>
            </div>
            <span class="icon-tile mb-4" set:html={stepIcons[i]} />
            <h3 class="text-lg text-custom-black mb-2">{step.title}</h3>
            <p class="text-custom-dark-gray text-sm leading-relaxed">{step.desc}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <CtaSection
    title={copy.ctaTitle}
    subtitle={copy.ctaSub}
    bg="bg-surface"
    lang={lang}
  />
</BaseLayout>

<script>
  import { initReveal } from '../scripts/reveal';
  initReveal();
</script>
