---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import LinksModal from '../../components/LinksModal.astro';
---

<BaseLayout
  title="Proyectos de UX y Front-End | Portafolio de Frani Medina"
  description="Proyectos de diseño UX y desarrollo front-end: sitios web, productos digitales e identidades de marca creados por Francisca Medina."
>
  <PageHero
    title="Conoce más acerca de mis Proyectos y Portafolio"
    path={[{ label: 'proyectos' }]}
    subtitle="Diseño UX, desarrollo front-end y proyectos de impacto social. Cada uno con una historia detrás."
    ctaLabel="Explorar proyectos"
    ctaHref="#all-projects-container"
    ctaIcon="down"
  />

  <section class="section-block-sm bg-custom-light-grey">
    <div class="container-wide">
      <div id="all-projects-container" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8"></div>
    </div>
  </section>

  <LinksModal />
</BaseLayout>

<script>
  import { initReveal } from '../../scripts/reveal';
  import { buildProjectCardHTML, extractYear, initLinksModal, revealProjectCards, type Project } from '../../scripts/projects';
  initReveal();

  async function initProjects() {
    const res = await fetch('/data/projects.json');
    const data = await res.json();
    let projects: Project[] = data.projects || [];
    projects.sort((a, b) => extractYear(b.date ?? '') - extractYear(a.date ?? ''));

    const container = document.getElementById('all-projects-container');
    if (!container) return;
    container.innerHTML = projects.map(buildProjectCardHTML).join('');

    revealProjectCards();
    initLinksModal(projects);
  }

  initProjects();
</script>
