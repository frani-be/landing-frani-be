---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Mi Trayectoria | Francisca Beatriz Medina Concha"
  description="Trayectoria profesional completa de Francisca Beatriz Medina Concha: experiencia laboral, formación académica, docencia y voluntariados."
  ogUrl="https://frani.be/trayectoria"
>
  <!-- Editorial hero -->
  <header class="tray-hero pt-36 pb-16 lg:pt-44 lg:pb-24">
    <div class="container-wide flex flex-col lg:flex-row items-center gap-12 lg:gap-10">
      <div class="w-full lg:w-[55%] text-center lg:text-left">
        <span class="tray-tag" data-reveal>~/trayectoria</span>
        <h1 class="tray-title" data-reveal data-reveal-delay="120">
          Mi trayectoria
        </h1>
        <p class="tray-lead" data-reveal data-reveal-delay="260">
          Diseño, desarrollo, docencia y comunidad: un mismo recorrido entre productos digitales, aulas y espacios STEAM.
        </p>
        <div class="flex flex-wrap gap-4 mt-8 justify-center lg:justify-start" data-reveal data-reveal-delay="380">
          <a href="#timeline-container" class="btn btn-primary">Explorar experiencias ↓</a>
          <a
            href="/documents/cv-francisca-medina-concha.pdf"
            download
            class="btn btn-secondary"
            aria-label="Descargar CV en formato PDF"
          >Descargar CV<span class="btn-arrow" aria-hidden="true">↗</span></a>
        </div>
      </div>
      <div class="w-full lg:w-[45%] flex justify-center" data-reveal data-reveal-delay="300">
        <div class="tray-illus">
          <div class="tray-blob" aria-hidden="true"></div>
          <img
            src="/images/trabajando.png"
            alt="Ilustración de Frani frente a un tablero de trabajo, ordenando tarjetas que conectan diseño y código"
            class="tray-illus-img"
          />
        </div>
      </div>
    </div>
  </header>

  <section class="pt-10 pb-20 bg-custom-light-grey">
    <div class="container-wide">

      <!-- 3 Pillars (compactos) -->
      <div class="flex flex-wrap justify-center gap-6 mb-10">
        <div class="text-center flex-1 min-w-[240px] max-w-[320px]" data-animate>
          <div class="icon-tile icon-tile-lg mx-auto mb-3" aria-hidden="true">
            <img src="/images/icons/pilar-codigo.png" alt="" loading="lazy" />
          </div>
          <h2 class="text-[1.1em] mb-2">Estrategia + código</h2>
          <p class="text-custom-dark-gray text-sm">Líder en UX y front-end. Traduzco necesidades corporativas complejas en interfaces escalables.</p>
        </div>
        <div class="text-center flex-1 min-w-[240px] max-w-[320px]" data-animate>
          <div class="icon-tile icon-tile-lg mx-auto mb-3" aria-hidden="true">
            <img src="/images/icons/pilar-docencia.png" alt="" loading="lazy" />
          </div>
          <h2 class="text-[1.1em] mb-2">Formación sólida</h2>
          <p class="text-custom-dark-gray text-sm">Diplomada en ing. de software y diseño. Docente en universidades y bootcamps.</p>
        </div>
        <div class="text-center flex-1 min-w-[240px] max-w-[320px]" data-animate>
          <div class="icon-tile icon-tile-lg mx-auto mb-3" aria-hidden="true">
            <img src="/images/icons/pilar-comunidad.png" alt="" loading="lazy" />
          </div>
          <h2 class="text-[1.1em] mb-2">Speaker y voluntaria</h2>
          <p class="text-custom-dark-gray text-sm">Speaker internacional y activista STEAM. Promuevo inclusión real en tecnología.</p>
        </div>
      </div>

      <!-- Filter Buttons -->
      <div class="flex flex-wrap justify-center gap-3 mb-8 text-center">
        <button class="filter-btn text-sm transition-all font-primary font-medium text-custom-dark-gray border-custom-purple/40 border border-solid bg-white py-0.5 px-5 rounded-full cursor-pointer" data-filter="all">Todo</button>
        <button class="filter-btn text-sm transition-all font-primary font-medium text-laboral border-laboral border border-solid bg-white py-0.5 px-5 rounded-full cursor-pointer" data-filter="laboral">Profesional</button>
        <button class="filter-btn text-sm transition-all font-primary font-medium text-docencia border-docencia border border-solid bg-white py-0.5 px-5 rounded-full cursor-pointer" data-filter="docencia">Docencia</button>
        <button class="filter-btn text-sm transition-all font-primary font-medium text-voluntariados border-voluntariados border border-solid bg-white py-0.5 px-5 rounded-full cursor-pointer" data-filter="voluntariados">Comunidad</button>
        <button class="filter-btn text-sm transition-all font-primary font-medium text-academica border-academica border border-solid bg-white py-0.5 px-5 rounded-full cursor-pointer" data-filter="academica">Formación</button>
      </div>

      <!-- Global Controls -->
      <div class="flex justify-center gap-2 mb-8 text-center" id="global-controls">
        <button id="expand-all-btn" class="global-control-btn text-xs transition-all font-primary font-medium text-custom-dark-gray border-custom-dark-gray border border-solid bg-white py-0.5 px-3 rounded-full cursor-pointer">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" class="mr-1 inline">
            <path d="M6 9L12 15L18 9" stroke="currentColor" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          Expandir todo
        </button>
        <button id="collapse-all-btn" class="global-control-btn text-xs transition-all font-primary font-medium text-custom-dark-gray border-custom-dark-gray border border-solid bg-white py-0.5 px-3 rounded-full cursor-pointer">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" class="mr-1 inline rotate-180">
            <path d="M6 9L12 15L18 9" stroke="currentColor" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          Colapsar todo
        </button>
      </div>

      <!-- Timeline: lista continua -->
      <div class="max-w-[820px] mx-auto" id="timeline-container"></div>
    </div>
  </section>
</BaseLayout>

<script>
  import { initReveal } from '../scripts/reveal';
  initReveal();

  // Stagger the pillar cards
  document.querySelectorAll<HTMLElement>('[data-animate]').forEach((el, i) => {
    el.style.opacity = '0';
    el.style.transform = 'translateY(24px)';
    el.animate(
      [{ opacity: '0', transform: 'translateY(52px)' }, { opacity: '1', transform: 'translateY(0)' }],
      { duration: 1100, delay: 200 + i * 300, easing: 'cubic-bezier(0.16,1,0.3,1)', fill: 'forwards' }
    );
  });
</script>

<script>
  interface TimelineItem {
    id: number;
    title: string;
    company: string;
    location: string;
    startDate: string;
    endDate: string;
    category: string;
    description: string;
  }

  const strokeIcon = (inner: string) =>
    `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="cat-icon" aria-hidden="true">${inner}</svg>`;

  const CATEGORIES: Record<string, { label: string; color: string; cssText: string; cssBg: string; cssBorder: string; icon: string }> = {
    laboral:       { label: 'Profesional', color: '#2555a3', cssText: 'text-laboral',       cssBg: 'bg-laboral',       cssBorder: 'border-laboral',       icon: strokeIcon('<rect x="3" y="8" width="18" height="12" rx="2"/><path d="M9 8V6a3 3 0 0 1 6 0v2"/>') },
    docencia:      { label: 'Docencia',    color: '#7d1fc7', cssText: 'text-docencia',      cssBg: 'bg-docencia',      cssBorder: 'border-docencia',      icon: strokeIcon('<path d="M4 4.5h5a4 4 0 0 1 3 1.7A4 4 0 0 1 15 4.5h5V19h-5a3 3 0 0 0-3 1.5A3 3 0 0 0 9 19H4z"/>') },
    voluntariados: { label: 'Comunidad',   color: '#bd2c97', cssText: 'text-voluntariados', cssBg: 'bg-voluntariados', cssBorder: 'border-voluntariados', icon: strokeIcon('<path d="M12 20s-7-4.6-9-9c-1.4-3.2.5-7 4-7 2.4 0 4 1.4 5 2.8C13 5.4 14.6 4 17 4c3.5 0 5.4 3.8 4 7-2 4.4-9 9-9 9z"/>') },
    academica:     { label: 'Formación',   color: '#9f2eba', cssText: 'text-academica',     cssBg: 'bg-academica',     cssBorder: 'border-academica',     icon: strokeIcon('<path d="M2 9.5L12 5l10 4.5-10 4.5z"/><path d="M6 12v4c3 2 9 2 12 0v-4"/>') },
  };

  function formatDate(d: string) {
    if (d === 'actualidad') return 'Actualidad';
    return d.slice(0, 4);
  }

  function processBoldText(text: string) {
    return text.replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>').replace(/__(.*?)__/g, '<strong>$1</strong>');
  }

  function parseMarkdown(text: string) {
    if (!text) return '';
    const lines = text.split('\n');
    let inList = false;
    const result: string[] = [];
    const hasListItems = lines.some(l => l.trim().startsWith('- '));
    for (let i = 0; i < lines.length; i++) {
      const line = lines[i].trim();
      if (line.startsWith('- ')) {
        if (!inList) { result.push('<ul class="timeline-list">'); inList = true; }
        result.push(`<li>${processBoldText(line.substring(2))}</li>`);
      } else {
        if (inList) { result.push('</ul>'); inList = false; }
        if (line) {
          if (hasListItems) {
            result.push(`<p>${processBoldText(line)}</p>`);
          } else {
            if (result.length === 0) result.push('<p>');
            result.push(processBoldText(line));
            if (i < lines.length - 1 && lines[i + 1].trim()) result.push(' ');
          }
        }
      }
    }
    if (inList) result.push('</ul>');
    if (!hasListItems && result.length > 0) result.push('</p>');
    return result.join('');
  }

  function createTimelineItem(item: TimelineItem) {
    const cat = CATEGORIES[item.category] || { label: item.category, color: '#565656', icon: '' };
    const mdHTML = parseMarkdown(item.description);
    return `
      <div class="tl-item opacity-0 transition-all duration-500"
           data-category="${item.category}"
           style="--category-color:${cat.color};transform:translateY(20px);">
        <div class="tl-dates">${formatDate(item.startDate)}<span class="tl-sep">–</span>${formatDate(item.endDate)}</div>
        <div class="timeline-content bg-white shadow-sm transition-transform font-primary p-5">
          <button class="timeline-head" data-item-id="${item.id}" aria-expanded="false" aria-controls="description-${item.id}">
            <span class="head-top">
              <span class="timeline-category">${cat.icon}${cat.label}</span>
            </span>
            <span class="head-title">${item.title}</span>
            <span class="head-meta">${item.company} • ${item.location}</span>
            <svg class="head-chevron" width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M6 9L12 15L18 9" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
          <div class="timeline-description collapsed text-custom-black overflow-hidden leading-relaxed" id="description-${item.id}">${mdHTML}</div>
        </div>
      </div>`;
  }

  let allItems: TimelineItem[] = [];

  function renderTimeline(filter: string) {
    const filtered = filter === 'all' ? [...allItems] : allItems.filter(i => i.category === filter);

    const isCurrent = (i: TimelineItem) => i.endDate === 'actualidad';
    const byEndDesc = (a: TimelineItem, b: TimelineItem) =>
      new Date(b.endDate + '-01').getTime() - new Date(a.endDate + '-01').getTime();
    const byStartDesc = (a: TimelineItem, b: TimelineItem) =>
      new Date(b.startDate + '-01').getTime() - new Date(a.startDate + '-01').getTime();

    const ordered = [
      ...filtered.filter(isCurrent).sort(byStartDesc),
      ...filtered.filter(i => !isCurrent(i)).sort(byEndDesc),
    ];

    const container = document.getElementById('timeline-container');
    if (!container) return;
    container.innerHTML = ordered.map(createTimelineItem).join('');

    setTimeout(() => {
      document.querySelectorAll('.tl-item').forEach((el, i) => {
        setTimeout(() => el.classList.add('animate-in'), i * 60);
      });
    }, 50);

    setupToggleListeners();
    setupGlobalControls();
  }

  function setExpanded(head: HTMLElement, expanded: boolean) {
    const desc = document.getElementById(head.getAttribute('aria-controls') || '');
    if (!desc) return;
    head.setAttribute('aria-expanded', String(expanded));
    desc.classList.toggle('collapsed', !expanded);
    desc.classList.toggle('expanded', expanded);
  }

  function setupToggleListeners() {
    document.querySelectorAll('.timeline-head').forEach(btn => {
      btn.addEventListener('click', () => {
        setExpanded(btn as HTMLElement, btn.getAttribute('aria-expanded') !== 'true');
      });
    });
  }

  function setupGlobalControls() {
    document.getElementById('expand-all-btn')?.addEventListener('click', () => {
      document.querySelectorAll<HTMLElement>('.timeline-head').forEach(h => setExpanded(h, true));
    });
    document.getElementById('collapse-all-btn')?.addEventListener('click', () => {
      document.querySelectorAll<HTMLElement>('.timeline-head').forEach(h => setExpanded(h, false));
    });
  }

  function updateActiveFilter(filter: string) {
    document.querySelectorAll('.filter-btn').forEach(btn => {
      const f = (btn as HTMLElement).dataset.filter!;
      const isActive = f === filter;
      const cat = CATEGORIES[f];
      btn.classList.toggle('active', isActive);
      if (cat) {
        if (isActive) {
          btn.classList.add(cat.cssBg, 'text-white');
          btn.classList.remove('bg-white', cat.cssText);
        } else {
          btn.classList.remove(cat.cssBg, 'text-white');
          btn.classList.add('bg-white', cat.cssText, cat.cssBorder);
        }
      } else {
        if (isActive) {
          btn.classList.add('bg-custom-purple', 'text-white', 'border-custom-purple');
          btn.classList.remove('bg-white', 'text-custom-dark-gray');
        } else {
          btn.classList.remove('bg-custom-purple', 'text-white', 'border-custom-purple');
          btn.classList.add('bg-white', 'text-custom-dark-gray');
        }
      }
    });
  }

  // Setup filter button listeners
  document.querySelectorAll('.filter-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const filter = (btn as HTMLElement).dataset.filter!;
      renderTimeline(filter);
      updateActiveFilter(filter);
    });
  });

  // Init
  fetch('/data/timeline.json')
    .then(r => r.json())
    .then(data => {
      allItems = data.timeline || [];
      renderTimeline('all');
      updateActiveFilter('all');
    });
</script>
