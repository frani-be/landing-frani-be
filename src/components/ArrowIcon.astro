---
import { ICON_PATHS, type IconName } from '../scripts/icons';

interface Props {
  name: IconName;
  class?: string;
}

const { name, class: extraClass = '' } = Astro.props;
---

<svg
  class:list={['icon-arrow', extraClass]}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  <path d={ICON_PATHS[name]} />
</svg>
