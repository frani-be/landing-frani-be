---
import BaseLayout from '../layouts/BaseLayout.astro';
import { localePath, type Lang } from '../i18n/ui';

interface Props { lang: Lang; }
const { lang } = Astro.props;

const copy = {
  es: {
    title: 'Charlas sobre UX, front-end y STEAM | Frani Medina',
    description: 'Charlas y presentaciones de Francisca Medina sobre diseño UX, desarrollo front-end, docencia en tecnología y comunidades STEAM.',
    heroTitle: 'Charlas y presentaciones',
    heroSub: 'Videos de mis charlas sobre UX, front-end, docencia y comunidades en tecnología.',
    pathLabel: 'charlas',
    alt: 'Ilustración de Frani dando una charla tech desde un atril, con micrófono y credencial',
    soon: '// próximamente',
    body: 'Estoy preparando esta sección con los videos de mis charlas. Mientras tanto, puedes escribirme si te interesa algún tema.',
    cta: 'Contáctame',
  },
  en: {
    title: 'Talks on UX, Front-End & STEAM | Frani Medina',
    description: 'Talks and presentations by Francisca Medina on UX design, front-end development, tech education and STEAM communities.',
    heroTitle: 'Talks and presentations',
    heroSub: 'Videos of my talks on UX, front-end, teaching and tech communities.',
    pathLabel: 'charlas',
    alt: 'Illustration of Frani giving a tech talk from a podium, with microphone and badge',
    soon: '// coming soon',
    body: "I'm preparing this section with videos of my talks. Meanwhile, feel free to reach out if you're interested in a topic.",
    cta: 'Contact me',
  },
}[lang];
---

<BaseLayout
  title={copy.title}
  description={copy.description}
  lang={lang}
>
  <!-- Hero editorial claro, mismo sistema que proyectos -->
  <header class="light-hero">
    <div class="container-wide light-hero-grid">
      <div data-reveal>
        <nav class="mono-path mb-6" aria-label={lang === 'en' ? 'Path' : 'Ruta'}>
          <a href={localePath('/', lang)}>~</a>
          <span class="mono-path-sep" aria-hidden="true">/</span>
          <span>{copy.pathLabel}</span>
        </nav>
        <h1 class="light-hero-title">{copy.heroTitle}</h1>
        <p class="light-hero-sub">{copy.heroSub}</p>
      </div>
      <div class="light-hero-deco" aria-hidden="true">
        <img
          class="light-hero-img"
          src="/images/charla.webp"
          alt=""
          width="1200"
          height="1200"
          loading="eager"
          decoding="async"
        />
      </div>
    </div>
  </header>

  <section class="section-block-sm bg-custom-light-grey">
    <div class="container-narrow text-center" data-reveal>
      <p class="font-mono text-[0.9rem] text-custom-purple-dark mb-4">{copy.soon}</p>
      <p class="text-custom-dark-gray leading-relaxed mb-8">{copy.body}</p>
      <a href="#contacto" class="btn btn-primary">{copy.cta}</a>
    </div>
  </section>
</BaseLayout>

<script>
  import { initReveal } from '../scripts/reveal';
  initReveal();
</script>
