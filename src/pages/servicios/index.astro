---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import CtaSection from '../../components/CtaSection.astro';
import ArrowIcon from '../../components/ArrowIcon.astro';
import { serviceIcons, secondaryIcons } from '../../scripts/serviceIcons';

const principales = [
  {
    slug: 'desarrollo-web',
    icon: serviceIcons['desarrollo-web'],
    title: 'Lanza tu sitio web',
    short: 'Diseño y desarrollo tu sitio completo: rápido, autogestionable y a tu medida. De la idea al aire.',
  },
  {
    slug: 'diseno-grafico',
    icon: serviceIcons['diseno-grafico'],
    title: 'Haz única tu marca',
    short: 'Identidad visual completa: logo, paleta y piezas coherentes que comunican lo mismo en todo canal.',
  },
  {
    slug: 'estrategia-ux',
    icon: serviceIcons['estrategia-ux'],
    title: 'Ordena tu producto',
    short: 'Auditoría UX basada en evidencia: research, arquitectura, prototipos y tests que hacen fluir a usuarios.',
  },
  {
    slug: 'clases-particulares',
    icon: serviceIcons['clases-particulares'],
    title: 'Aprende a tu ritmo',
    short: 'Clases 1 a 1 de diseño, UX o front-end con proyectos reales y feedback directo en cada sesión.',
  },
];

const secundarios = [
  { icon: secondaryIcons['auditoria-cro-seo'], title: 'Auditoría CRO, SEO y GEO', short: 'Análisis técnico y de contenidos para mejorar tu conversión y tu visibilidad en buscadores y motores de IA.' },
  { icon: secondaryIcons['asesorias-personales'], title: 'Asesorías personales', short: 'Orientación personalizada para profesionales y emprendedores que quieren adentrarse en el mundo tecnológico.' },
  { icon: secondaryIcons['ugc'], title: 'UGC', short: 'Creación de contenido generado por usuario (User Generated Content) para marcas digitales y campañas en redes.' },
  { icon: secondaryIcons['mentorias-charlas'], title: 'Mentorías para charlas', short: 'Te ayudo a estructurar y ensayar tu presentación para que llegues segura/seguro al escenario o al evento.' },
  { icon: secondaryIcons['apoyo-freelance'], title: 'Apoyo freelance', short: 'Colaboración técnica o de diseño puntual para agencias y equipos que necesitan refuerzo en proyectos específicos.' },
  { icon: secondaryIcons['generacion-contenido'], title: 'Generación de contenido', short: 'Copywriting UX, artículos, newsletters y contenido para redes con enfoque en comunicación clara y accionable.' },
];
---

<BaseLayout
  title="Servicios | Francisca Beatriz Medina Concha"
  description="Servicios de desarrollo web, diseño gráfico, estrategia UX y clases particulares ofrecidos por Francisca Beatriz Medina Concha."
  ogUrl="https://frani.be/servicios"
>
  <PageHero
    title="Conoce más acerca de mis Servicios y cómo puedo ayudarte"
    path={[{ label: 'servicios' }]}
    subtitle="Diseño, desarrollo y estrategia al servicio de proyectos con propósito."
    ctaLabel="Explorar servicios"
    ctaHref="#principales"
    ctaIcon="down"
  />

  <!-- Principales -->
  <section class="section-block-sm bg-surface" id="principales">
    <div class="container-wide">
      <h2 class="text-2xl text-custom-black mb-12 text-center" data-reveal>Servicios principales</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {principales.map((s, i) => (
          <a href={`/servicios/${s.slug}`} class="service-card group" data-reveal data-reveal-delay={String(i * 100)}>
            <div class="service-card-icon"><img src={s.icon} alt="" loading="lazy" /></div>
            <div class="p-6 flex flex-col flex-1">
              <h3 class="text-xl mb-3">{s.title}</h3>
              <p class="text-custom-dark-gray text-sm flex-1">{s.short}</p>
              <span class="service-link mt-5">Ver detalles<ArrowIcon name="upRight" class="btn-arrow" /></span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Secundarios -->
  <section class="section-block-sm bg-custom-light-grey">
    <div class="container-wide">
      <h2 class="text-2xl text-custom-black mb-12 text-center" data-reveal>También puedo ayudarte con…</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {secundarios.map((s, i) => (
          <article class="bg-surface rounded-[var(--radius-card)] border border-border-soft p-6 flex gap-5 items-start hover:shadow-md hover:border-border-hover transition-all duration-300" data-reveal data-reveal-delay={String(i * 80)}>
            <span class="icon-tile mt-1"><img src={s.icon} alt="" loading="lazy" /></span>
            <div>
              <h3 class="text-lg text-custom-black mb-2">{s.title}</h3>
              <p class="text-custom-dark-gray text-sm">{s.short}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <CtaSection
    title="¿Listo/a para empezar?"
    subtitle="Agendemos una videollamada sin compromiso para hablar de tu proyecto."
    bg="bg-surface"
  />
</BaseLayout>

<script>
  import { initReveal } from '../../scripts/reveal';
  initReveal();
</script>
