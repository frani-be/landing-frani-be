---
import Breadcrumb from './Breadcrumb.astro';

interface Crumb { label: string; href?: string; }

interface Props {
  title: string;
  subtitle?: string;
  crumbs?: Crumb[];
  ghost?: string;
  ctaLabel?: string;
  ctaHref?: string;
}

const { title, subtitle, crumbs, ghost = title, ctaLabel, ctaHref } = Astro.props;
---

<header class="page-hero relative overflow-hidden text-white pt-40 pb-24 text-center">
  <div class="container-mid relative z-[1]">

    {crumbs && crumbs.length > 0 && (
      <div class="page-hero-breadcrumb">
        <Breadcrumb crumbs={crumbs} />
      </div>
    )}

    <div class="relative" data-reveal>
      <span
        class="page-hero-ghost"
        aria-hidden="true"
        role="presentation"
      >{ghost}</span>
      <h1 class="page-hero-title">{title}</h1>
    </div>

    {subtitle && (
      <p class="page-hero-subtitle" data-reveal data-reveal-delay="150">
        {subtitle}
      </p>
    )}

    {ctaLabel && ctaHref && (
      <div class="mt-8" data-reveal data-reveal-delay="300">
        <a href={ctaHref} class="btn btn-outline-white">{ctaLabel}</a>
      </div>
    )}

    <slot />
  </div>
</header>
