---
import ProyectoDetailView from '../../../views/ProyectoDetailView.astro';
import projectsData from '../../../../public/data/projects.en.json';

export function getStaticPaths() {
  const sorted = [...projectsData.projects].sort((a, b) => {
    const getYear = (d: string) => { const m = d?.match(/\d{4}/g); return m ? Math.max(...m.map(Number)) : 0; };
    return getYear(b.date) - getYear(a.date);
  });
  return sorted.map((p, i) => ({
    params: { id: p.id },
    props: {
      project: p,
      prevProject: i === 0 ? sorted[sorted.length - 1] : sorted[i - 1],
      nextProject: i === sorted.length - 1 ? sorted[0] : sorted[i + 1],
    },
  }));
}

const { project, prevProject, nextProject } = Astro.props;
---

<ProyectoDetailView lang="en" project={project} prevProject={prevProject} nextProject={nextProject} />
