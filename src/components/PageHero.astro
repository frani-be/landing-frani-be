---
import ArrowIcon from './ArrowIcon.astro';
import type { IconName } from '../scripts/icons';
import { localePath, type Lang } from '../i18n/ui';

interface PathSegment { label: string; href?: string; }

interface Props {
  title: string;
  subtitle?: string;
  path?: PathSegment[];
  ctaLabel?: string;
  ctaHref?: string;
  ctaIcon?: IconName;
  lang?: Lang;
}

const { title, subtitle, path, ctaLabel, ctaHref, ctaIcon, lang = 'es' } = Astro.props;
---

<header class="page-hero relative overflow-hidden text-white pt-40 pb-24 text-center">
  <div class="container-mid relative z-[1]">

    <div data-reveal>
      {path && path.length > 0 && (
        <nav class="page-hero-path" aria-label="Ruta">
          <a href={localePath('/', lang)}>~</a>
          {path.map(seg => (
            <>
              <span class="sep">/</span>
              {seg.href
                ? <a href={seg.href}>{seg.label}</a>
                : <span class="current">{seg.label}</span>}
            </>
          ))}
        </nav>
      )}
      <h1 class="page-hero-title">{title}</h1>
    </div>

    {subtitle && (
      <p class="page-hero-subtitle" data-reveal data-reveal-delay="150">
        {subtitle}
      </p>
    )}

    {ctaLabel && ctaHref && (
      <div class="mt-8" data-reveal data-reveal-delay="300">
        <a href={ctaHref} class="btn btn-outline-white">{ctaLabel}{ctaIcon && <ArrowIcon name={ctaIcon} class="btn-arrow" />}</a>
      </div>
    )}

    <slot />
  </div>
</header>
