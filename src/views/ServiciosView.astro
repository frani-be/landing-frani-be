---
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaSection from '../components/CtaSection.astro';
import ArrowIcon from '../components/ArrowIcon.astro';
import { serviceIcons, secondaryIcons } from '../scripts/serviceIcons';
import { localePath, t, type Lang } from '../i18n/ui';

interface Props { lang: Lang; }
const { lang } = Astro.props;

const copy = {
  es: {
    title: 'Servicios de diseño UX y desarrollo web | Frani Medina',
    description: 'Desarrollo web, estrategia UX y clases particulares ofrecidos por Francisca Medina: diseño y código en una sola persona.',
    heroTitle: 'Una sola persona,<br>todo el proceso.',
    heroSub: 'Lanza tu sitio, haz única tu marca, ordena tu producto o aprende a tu ritmo.',
    heroCta: 'Explorar servicios',
    illusAlt: 'Ilustración de Frani saludando con su cuaderno lavanda',
    mainTitle: 'Servicios principales',
    mainSlots: 'Sin cupos disponibles',
    secondarySlots: '3 cupos disponibles',
    secondaryTitle: 'También puedo ayudarte con…',
    details: 'Ver detalles',
    ctaTitle: '¿Listo/a para empezar?',
    ctaSub: 'Agendemos una videollamada sin compromiso.',
    processTag: '// proceso',
    processTitle: 'Cómo es trabajar conmigo',
    processSub: 'El mismo proceso claro para todo proyecto: transparencia de la primera llamada a la entrega.',
    process: [
      { title: 'Videollamada inicial', desc: 'Me cuentas tu idea, objetivos y contexto. Sin costo ni compromiso.' },
      { title: 'Discovery', desc: 'Investigo contexto, usuarios y competencia para definir el alcance real.' },
      { title: 'Propuesta cerrada', desc: 'Entregables, tiempos y presupuesto concretos. Sin sorpresas.' },
      { title: 'Diseño y desarrollo', desc: 'Iteramos con entregas parciales y feedback continuo hasta dar con la solución.' },
      { title: 'Entrega y lanzamiento', desc: 'Archivos, handoff y soporte post-entrega incluidos.' },
    ],
    principales: [
      { slug: 'desarrollo-web', title: 'Lanza tu sitio web', short: 'Tu sitio completo, rápido y autogestionable. De la idea al aire.' },
      { slug: 'estrategia-ux', title: 'Ordena tu producto', short: 'UX con evidencia: research, prototipos y tests que hacen fluir tu producto.' },
      { slug: 'clases-particulares', title: 'Aprende a tu ritmo', short: 'Clases 1 a 1 de diseño, UX o front-end, con proyectos reales y feedback directo.' },
    ],
    secundarios: [
      { icon: 'auditoria-cro-seo', title: 'Auditoría CRO, SEO y GEO', short: 'Análisis para mejorar tu conversión y tu visibilidad en buscadores e IA.' },
      { icon: 'asesorias-personales', title: 'Asesorías personales', short: 'Orientación para profesionales y emprendedores que se adentran al mundo tech.' },
      { icon: 'ugc', title: 'UGC', short: 'Contenido generado por usuarios para marcas y campañas en redes.' },
      { icon: 'mentorias-charlas', title: 'Mentorías para charlas', short: 'Estructura y ensayo de tu presentación para llegar con confianza al escenario.' },
      { icon: 'apoyo-freelance', title: 'Apoyo freelance', short: 'Refuerzo técnico o de diseño para agencias y equipos en proyectos puntuales.' },
      { icon: 'generacion-contenido', title: 'Generación de contenido', short: 'Copywriting UX, artículos y newsletters con comunicación clara y accionable.' },
    ],
  },
  en: {
    title: 'UX Design & Web Development Services | Frani Medina',
    description: 'Web development, UX strategy and private classes by Francisca Medina: design and code in one person.',
    heroTitle: 'One person,<br>the whole process.',
    heroSub: 'Launch your site, make your brand unique, streamline your product or learn at your own pace.',
    heroCta: 'Explore services',
    illusAlt: 'Illustration of Frani waving with her lavender notebook',
    mainTitle: 'Main services',
    mainSlots: 'No slots available',
    secondarySlots: '3 spots available',
    secondaryTitle: 'I can also help you with…',
    details: 'View details',
    ctaTitle: 'Ready to start?',
    ctaSub: "Let's book a free call to talk about your project.",
    processTag: '// process',
    processTitle: 'What working with me looks like',
    processSub: 'The same clear process for any project: transparency from kickoff to delivery.',
    process: [
      { title: 'Kickoff call', desc: 'Tell me your idea, goals and context. Free, no strings attached.' },
      { title: 'Discovery', desc: 'I research context, users and competitors to define the real scope.' },
      { title: 'Fixed-scope proposal', desc: 'Concrete deliverables, timeline and budget. No surprises.' },
      { title: 'Design & build', desc: 'We iterate with partial deliveries and continuous feedback until we nail it.' },
      { title: 'Delivery & launch', desc: 'Files, handoff and post-delivery support included.' },
    ],
    principales: [
      { slug: 'desarrollo-web', title: 'Launch your website', short: 'Your full site, fast and self-manageable. From idea to launch.' },
      { slug: 'estrategia-ux', title: 'Streamline your product', short: 'Evidence-backed UX: research, prototypes and tests that make your product flow.' },
      { slug: 'clases-particulares', title: 'Learn at your own pace', short: '1-on-1 design, UX or front-end classes with real projects and direct feedback.' },
    ],
    secundarios: [
      { icon: 'auditoria-cro-seo', title: 'CRO, SEO & GEO audit', short: 'Analysis to improve conversion and visibility in search engines and AI.' },
      { icon: 'asesorias-personales', title: '1-on-1 consulting', short: 'Guidance for professionals and entrepreneurs entering tech.' },
      { icon: 'ugc', title: 'UGC', short: 'User-generated content for brands and social campaigns.' },
      { icon: 'mentorias-charlas', title: 'Speaking coaching', short: 'Structure and rehearsal for your talk, so you hit the stage with confidence.' },
      { icon: 'apoyo-freelance', title: 'Freelance support', short: 'Technical or design reinforcement for agencies and teams on specific projects.' },
      { icon: 'generacion-contenido', title: 'Content creation', short: 'UX copywriting, articles and newsletters with a clear, actionable voice.' },
    ],
  },
}[lang];

/* Íconos del proceso: estilo sólido chunky; color por tema via currentColor.
   Los detalles internos (check, ventana) van en blanco como "knockout" */
const stepIcons = [
  // Videollamada
  `<svg viewBox="-8 36 352 220" aria-hidden="true"><path fill="currentColor" d="M328.1,74.6c-5.6-3.1-11.1-2.7-16.1.5l-74.7,47.6-.4-44.3c-.1-17.2-14.3-33-32.5-33H33C15,45.4,0,60.4,0,78.6l.3,135.4c0,20.1,18.2,32.8,36.8,32.7l167.4-.4c17.8,0,32.1-14.9,32.3-32.2l.5-43.3,74.5,47c5.1,3.2,10.8,3.6,16.3.5,3.9-2.1,7.3-7,7.3-13.7v-117.2C335.4,81.5,331.5,76.5,328.1,74.6Z"/></svg>`,
  // Discovery
  `<svg viewBox="450 5 285 288" aria-hidden="true"><path fill="currentColor" d="M678.3,199.3c33.4-47.7,29.8-110.9-8.5-154.5-34-38.6-90.1-51.4-137.2-33.4-71,27-100.5,109.3-65.1,175.6,33.8,63.4,114.6,85.3,176.3,46l50.4,50.8c9.6,9.6,24.8,10,33.9,1,9.2-9.2,10.1-24.4.3-34.4L678.3,199.3ZM576.8,211.9c-46.4,0-84-37.6-84-84.1s37.6-84,84-84,84.1,37.6,84.1,84S623.3,211.9,576.8,211.9Z"/></svg>`,
  // Propuesta cerrada
  `<svg viewBox="878 -2 228 296" aria-hidden="true"><path fill="currentColor" d="M1064.7,21.8c-7.5-7.6-13.5-15.6-22.6-21.7h-126c-18.5,0-33.2,14.5-33.3,33.3l-.2,221.9c0,19.2,13.8,35.8,33.5,35.9h172.7c17.5.1,33.3-13.1,33.4-31.3l.4-172.7c0-5-2-8.8-4.8-11.7L1064.7,21.8ZM1067,165.1l-66.9,67.3c-9.5,9.5-24.2,7.1-33-1.9l-29.6-30c-9-9.2-7.6-22.9.2-31,8.1-8.3,20.9-9.6,30.8-2l16.1,15.8,50.5-50.2c8.4-8.4,22.8-7.4,30.8.5C1073.9,141.6,1075.9,156.2,1067,165.1ZM1095,102.2l-53.4.3c-10.1,0-19.4-8.2-19.4-18.5V26.9c0-3.6,4.1-5.9,6.5-6.5,3-.7,6.6-.6,9.3,2.1l61.1,62.1c2.7,2.8,3.5,6.4,3.5,9.7C1102.6,97.2,1100,102.2,1095,102.2Z"/></svg>`,
  // Diseño y desarrollo
  `<svg viewBox="1268 32 350 222" aria-hidden="true"><path fill="currentColor" d="M1579.1,103.9l-58.1-58.3c-10-10-26.8-7.5-35.1,1.6-9.5,10.3-8.9,25.4.9,35.2l65.2,65.1-53.1,53c-6.1,6.2-12.6,11.3-17,18.8-5.4,11.1-2.5,23.3,6.7,30.9,7.6,6.4,22.1,9.1,30.9.3l83.9-83.6c6.4-6.4,8.8-14.2,8.3-23-.5-7.4-5.7-12.9-11.5-18.7L1579.1,103.9Z"/><path fill="currentColor" d="M1391.9,45c-10.9-9-25.7-6.7-35.7,3.5l-82.2,83.4c-9.2,9.4-6.3,25.8,2.5,34.6l83.6,83.5c9.7,9.7,26.5,6.8,34.2-2.3,8.4-10,9.4-24.5-.7-34.7l-64.6-64.9,38.2-39.3,27.5-27.3C1404,70.1,1402.6,53.8,1391.9,45Z"/></svg>`,
  // Entrega y lanzamiento
  `<svg viewBox="1722 -4 296 290" aria-hidden="true"><path fill="currentColor" d="M1786.8,196c-36.6-1.8-52.5,43.1-58.5,76.4-.4,2.5-.1,5.2,1.1,6.7,6.6,7.4,46.7-5.8,64.4-17.8,14.5-9.8,23-26.1,19.2-42.9C1810,205.4,1800.1,196.6,1786.8,196Z"/><path fill="currentColor" d="M1993.7.1c-65.4,3.7-125.9,32.8-167.9,83.3l-33.6.3c-12,.1-21.4,8.1-27.7,17.8l-25.9,39.8c-3.1,4.8-.5,13.9,5.6,14l30.2.4c22.1.3,41.7,8,56.8,23.8,12.7,13.2,20.8,29.8,20.8,49.1v28.7c.1,3.8,3.9,6.4,6.2,7.1,2.9.9,7,1.2,9.6-.7l41.3-30c8.2-6,13.7-16,13.8-26.1l.4-26.7c50.4-41,81.5-100.1,87.6-164.5.5-5.4-.2-9.8-3.3-12.8C2003.5-.1,1999.3-.2,1993.7.1ZM1920.8,121c-19.2,0-34.7-15.5-34.7-34.7s15.5-34.7,34.7-34.7,34.7,15.6,34.7,34.7S1939.9,121,1920.8,121Z"/></svg>`,
];
---

<BaseLayout
  title={copy.title}
  description={copy.description}
  lang={lang}
>
  <!-- Banner púrpura compartido (misma estructura que trayectoria) con ilustración propia -->
  <header class="page-hero page-hero-left relative overflow-hidden text-white pt-40 pb-16 lg:pb-24">
    <div class="container-wide relative z-[1] flex flex-col lg:flex-row items-center gap-12 lg:gap-10">
      <div class="w-full lg:w-[55%] text-center lg:text-left">
        <nav class="page-hero-path" aria-label={lang === 'en' ? 'Path' : 'Ruta'} data-reveal>
          <a href={localePath('/', lang)} aria-label={t(lang, 'breadcrumb.home')}>~</a>
          <span class="sep">/</span>
          <span class="current">servicios</span>
        </nav>
        <h1 class="page-hero-title" data-reveal data-reveal-delay="120" set:html={copy.heroTitle} />
        <p class="page-hero-subtitle" data-reveal data-reveal-delay="260">
          {copy.heroSub}
        </p>
        <div class="flex flex-wrap gap-4 mt-8 justify-center lg:justify-start" data-reveal data-reveal-delay="380">
          <a href="#principales" class="btn btn-outline-white">{copy.heroCta}<ArrowIcon name="down" class="btn-arrow" /></a>
        </div>
      </div>
      <div class="w-full lg:w-[45%] flex justify-center" data-reveal data-reveal-delay="300">
        <div class="hero-illus hero-illus--portrait">
          <div class="hero-blob" aria-hidden="true"></div>
          <img
            src="/images/saludando.webp"
            alt={copy.illusAlt}
            width="1024"
            height="1536"
            class="hero-illus-img"
            loading="eager"
            fetchpriority="high"
          />
        </div>
      </div>
    </div>
  </header>

  <!-- Principales -->
  <section class="section-block-sm bg-surface scroll-mt-24" id="principales">
    <div class="container-wide">
      <div class="text-center mb-12" data-reveal>
        <h2 class="text-2xl text-custom-black mb-4">{copy.mainTitle}</h2>
        <span class="hero-eyebrow hero-eyebrow--closed">{copy.mainSlots}</span>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {copy.principales.map((s, i) => (
          <a href={localePath(`/servicios/${s.slug}`, lang)} class="service-card group" data-reveal data-reveal-delay={String(i * 100)}>
            <div class="service-card-icon"><img src={serviceIcons[s.slug as keyof typeof serviceIcons]} alt="" loading="lazy" /></div>
            <div class="p-6 flex flex-col flex-1">
              <h3 class="text-xl mb-3">{s.title}</h3>
              <p class="text-custom-dark-gray text-sm flex-1">{s.short}</p>
              <span class="service-link mt-5">{copy.details}<ArrowIcon name="right" class="btn-arrow btn-arrow--right" /></span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Secundarios -->
  <section class="section-block-sm bg-custom-light-grey">
    <div class="container-wide">
      <div class="text-center mb-12" data-reveal>
        <h2 class="text-2xl text-custom-black mb-4">{copy.secondaryTitle}</h2>
        <span class="hero-eyebrow hero-eyebrow--available">{copy.secondarySlots}</span>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {copy.secundarios.map((s, i) => (
          <article class="bg-surface rounded-[var(--radius-card)] border border-border-soft p-6 flex gap-5 items-start hover:shadow-md hover:border-border-hover transition-all duration-300" data-reveal data-reveal-delay={String(i * 80)}>
            <span class="icon-tile mt-1"><img src={secondaryIcons[s.icon as keyof typeof secondaryIcons]} alt="" loading="lazy" /></span>
            <div>
              <h3 class="text-lg text-custom-black mb-2">{s.title}</h3>
              <p class="text-custom-dark-gray text-sm">{s.short}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Proceso -->
  <section class="section-block-sm bg-surface scroll-mt-24" id="proceso">
    <div class="container-wide">
      <div class="text-center mb-12" data-reveal>
        <p class="section-tag mb-4">{copy.processTag}</p>
        <h2 class="text-2xl md:text-3xl text-custom-black mb-4">{copy.processTitle}</h2>
        <p class="text-custom-dark-gray max-w-2xl mx-auto">{copy.processSub}</p>
      </div>
      <ol class="process-steps grid grid-cols-1 md:grid-cols-5 gap-10 md:gap-6">
        {copy.process.map((step, i) => (
          <li class="process-step" data-reveal data-reveal-delay={String(i * 90)}>
            <div class="process-head">
              <span class="icon-tile icon-tile--fill process-step-icon" set:html={stepIcons[i]} />
              <span class="process-line" aria-hidden="true"></span>
            </div>
            <h3 class="text-lg text-custom-black mb-2">{step.title}</h3>
            <p class="text-custom-dark-gray text-sm leading-relaxed">{step.desc}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <CtaSection
    title={copy.ctaTitle}
    subtitle={copy.ctaSub}
    bg="bg-surface"
    lang={lang}
  />
</BaseLayout>

<script>
  import { initReveal } from '../scripts/reveal';
  initReveal();
</script>
