---
import { t, type Lang } from '../i18n/ui';

interface Props { lang?: Lang; }
const { lang = 'es' } = Astro.props;
---

<div id="links-modal" class="hidden fixed inset-0 z-[9999] flex items-center justify-center" role="dialog" aria-modal="true" aria-label={t(lang, 'links.modal.title')}>
  <div class="absolute inset-0 bg-custom-black/50 backdrop-blur-sm"></div>
  <div class="relative bg-surface rounded-[var(--radius-card)] p-8 max-w-lg w-[90%] shadow-2xl animate-[modalSlideIn_0.3s_ease-out]">
    <button
      class="modal-close absolute top-4 right-4 text-4xl text-gray-400 hover:text-gray-600 transition-colors leading-none w-8 h-8 flex items-center justify-center"
      aria-label={t(lang, 'links.modal.close')}
    >&times;</button>
    <h3 class="text-2xl text-custom-black mb-6 pr-8">{t(lang, 'links.modal.title')}</h3>
    <div id="links-modal-body" class="flex flex-col gap-3"></div>
  </div>
</div>
