---
import '../styles/global.css';
import ContactSection from '../components/ContactSection.astro';
import EmbroideryPattern from '../components/EmbroideryPattern.astro';
import { t, localePath, type Lang } from '../i18n/ui';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  lang?: Lang;
}

const defaultDescriptions: Record<Lang, string> = {
  es: 'Portafolio de Francisca Medina (Frani): diseño UX estratégico, desarrollo front-end, charlas tech y mentorías STEAM desde Chile.',
  en: 'Portfolio of Francisca Medina (Frani): strategic UX design, front-end development, tech talks and STEAM mentoring from Chile.',
};

const {
  title,
  description,
  ogImage = 'https://frani.be/images/logo.jpg',
  lang = 'es',
} = Astro.props;
const metaDescription = description ?? defaultDescriptions[lang];

const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? 'https://frani.be').href;

// Ruta sin prefijo de idioma para calcular la URL alterna
const pathname = Astro.url.pathname;
const basePath = pathname.replace(/^\/en(?=\/|$)/, '') || '/';
const esUrl = new URL(basePath, Astro.site ?? 'https://frani.be').href;
const enUrl = new URL(localePath(basePath, 'en'), Astro.site ?? 'https://frani.be').href;

// Sección activa del nav: primer segmento de la ruta sin prefijo de idioma
const activeNav = basePath.split('/')[1] ?? '';

const navItems = [
  { key: 'trayectoria', href: localePath('/trayectoria', lang), label: t(lang, 'nav.experience') },
  { key: 'servicios', href: localePath('/servicios', lang), label: t(lang, 'nav.services') },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': 'https://frani.be/#persona',
      name: 'Francisca Beatriz Medina Concha',
      alternateName: 'Frani Medina',
      url: 'https://frani.be/',
      image: 'https://frani.be/images/frani.webp',
      jobTitle: 'Diseñadora UX estratégica y front-end engineer',
      description: metaDescription,
      email: 'mailto:hola@frani.be',
      nationality: { '@type': 'Country', name: 'Chile' },
      knowsAbout: [
        'UX Design', 'Front-End Development', 'Estrategia de producto digital',
        'Diseño gráfico', 'Docencia en tecnología', 'Comunidades STEAM',
      ],
      sameAs: [
        'https://www.linkedin.com/in/frani-be/',
        'https://github.com/frani-be',
        'https://www.instagram.com/frani.be/',
      ],
    },
    {
      '@type': 'WebSite',
      '@id': 'https://frani.be/#sitio',
      url: 'https://frani.be/',
      name: 'frani.be',
      inLanguage: ['es-CL', 'en'],
      publisher: { '@id': 'https://frani.be/#persona' },
    },
    {
      '@type': 'WebPage',
      url: canonicalUrl,
      name: title,
      description: metaDescription,
      inLanguage: lang === 'en' ? 'en' : 'es-CL',
      isPartOf: { '@id': 'https://frani.be/#sitio' },
    },
  ],
};
---

<!doctype html>
<html lang={lang} class="overflow-x-hidden">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="author" content="Francisca Beatriz Medina Concha" />
    <meta name="description" content={metaDescription} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={lang === 'en' ? 'en_US' : 'es_CL'} />
    <meta property="og:locale:alternate" content={lang === 'en' ? 'es_CL' : 'en_US'} />
    <meta property="og:site_name" content="frani.be" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={lang === 'en' ? 'Francisca Medina (Frani), strategic UX designer and front-end' : 'Francisca Medina (Frani), diseñadora UX estratégica y front-end'} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={metaDescription} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Datos estructurados -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <!-- hreflang -->
    <link rel="alternate" hreflang="es" href={esUrl} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="x-default" href={esUrl} />

    <!-- Idioma: primera visita detecta navigator.language; la elección persiste -->
    <script is:inline>
      (function () {
        try {
          if (!localStorage.getItem('lang')) {
            var nav = (navigator.language || 'es').toLowerCase();
            var detected = nav.indexOf('es') === 0 ? 'es' : 'en';
            var path = location.pathname;
            var isEn = path === '/en' || path.indexOf('/en/') === 0;
            if (path === '/' && detected === 'en') {
              localStorage.setItem('lang', 'en');
              location.replace('/en/');
              return;
            }
            // Deep links: si la URL es /en respétala; si no, guarda la preferencia detectada
            localStorage.setItem('lang', isEn ? 'en' : detected);
          }
        } catch (e) {}
      })();
    </script>

    <!-- Tema: aplicar clase antes del primer paint para evitar FOUC -->
    <meta name="theme-color" content="#faf8fc" />
    <script is:inline>
      (function () {
        var t = localStorage.getItem('theme');
        var dark = t === 'dark' || (!t && matchMedia('(prefers-color-scheme: dark)').matches);
        if (dark) {
          document.documentElement.classList.add('dark');
          document.querySelector('meta[name="theme-color"]')?.setAttribute('content', '#17101f');
        }
      })();
    </script>

    <!-- Favicons -->
    <link href="/favicons/apple-touch-icon-76x76.png" rel="apple-touch-icon" sizes="76x76" />
    <link href="/favicons/apple-touch-icon-120x120.png" rel="apple-touch-icon" sizes="120x120" />
    <link href="/favicons/apple-touch-icon-152x152.png" rel="apple-touch-icon" sizes="152x152" />
    <link href="/favicons/apple-touch-icon-180x180.png" rel="apple-touch-icon" sizes="180x180" />
    <link href="/favicons/icon-hires.png" rel="icon" sizes="192x192" />
    <link href="/favicons/icon-normal.png" rel="icon" sizes="128x128" />
    <link href="/favicons/icon.svg" rel="mask-icon" sizes="any" />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,100..1000;1,9..40,100..1000&family=JetBrains+Mono:wght@400;500&family=Space+Grotesk:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <slot name="head" />
  </head>

  <body class="overflow-x-hidden font-primary font-light text-custom-black text-base lg:text-lg">
    <a href="#contenido" class="skip-link">{t(lang, 'a11y.skip')}</a>
    <!-- Navigation -->
    <nav class="fixed top-0 left-1/2 -translate-x-1/2 w-full py-4 pb-6 z-[3] overflow-visible" id="navigation" aria-label={t(lang, 'nav.main')}>
      <div class="w-full px-8 mx-auto max-w-[540px] sm:max-w-[722px] md:max-w-[900px] lg:max-w-[1220px] xl:max-w-[1380px] flex items-center justify-between gap-6">
        <div class="logo-container">
          <a href={localePath('/', lang)} aria-label={t(lang, 'nav.home')}>
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 300 70.3">
              <use href="/images/icons.svg#logo"></use>
            </svg>
          </a>
        </div>
        <div class="hidden md:flex items-center gap-1">
          {navItems.map(item => (
            <a
              href={item.href}
              class:list={['nav-link', { 'nav-link-active': activeNav === item.key }]}
              aria-current={activeNav === item.key ? 'page' : undefined}
            >{item.label}</a>
          ))}
          <a href="#contacto" class="btn btn-primary ml-2" style="padding:0.55rem 1.4rem">{t(lang, 'nav.contact')}</a>
        </div>
        <div class="lang-switch" role="group" aria-label={t(lang, 'nav.lang.switch')}>
          {(['es', 'en'] as const).map(l => (
            <a
              href={localePath(basePath, l)}
              class:list={['lang-opt', { 'lang-opt-active': lang === l }]}
              data-lang={l}
              aria-current={lang === l ? 'true' : undefined}
            >{l}</a>
          ))}
        </div>
        <button
          id="theme-toggle"
          class="flex items-center justify-center w-10 h-10 rounded-full text-custom-dark-gray hover:text-custom-purple hover:bg-custom-purple/10 transition-all"
          aria-label={t(lang, 'nav.theme')}
          aria-pressed="false"
        >
          <svg class="icon-moon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" />
          </svg>
          <svg class="icon-sun hidden" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
          </svg>
        </button>
        <button
          id="nav-toggle"
          class="md:hidden flex items-center justify-center w-10 h-10 rounded-full text-custom-dark-gray hover:text-custom-purple hover:bg-custom-purple/10 transition-all"
          aria-expanded="false"
          aria-controls="nav-mobile"
          aria-label={t(lang, 'nav.menu.open')}
          data-aria-open={t(lang, 'nav.menu.open')}
          data-aria-close={t(lang, 'nav.menu.close')}
        >
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
            <path class="nav-icon-open" d="M4 7h16M4 12h16M4 17h16" />
            <path class="nav-icon-close hidden" d="M6 6l12 12M18 6L6 18" />
          </svg>
        </button>
      </div>
      <div id="nav-mobile" class="md:hidden hidden px-8 pb-4">
        <div class="flex flex-col gap-1 bg-surface/90 backdrop-blur-md rounded-[var(--radius-card)] border border-border-soft shadow-lg p-3">
          {navItems.map(item => (
            <a
              href={item.href}
              class:list={['nav-link', { 'nav-link-active': activeNav === item.key }]}
              aria-current={activeNav === item.key ? 'page' : undefined}
            >{item.label}</a>
          ))}
          <a href="#contacto" class="btn btn-primary mt-2" style="padding:0.6rem 1.4rem">{t(lang, 'nav.contact')}</a>
        </div>
      </div>
    </nav>

    <main id="contenido">
      <slot />
      <ContactSection lang={lang} />
    </main>

    <!-- Footer -->
    <footer class="py-8 bg-gradient-footer text-white relative overflow-hidden">
      <div class="container-wide text-center relative z-[1]">
        <EmbroideryPattern class="embroidery--light mx-auto mb-5" cells={4} />
        <p class="text-[0.75em] opacity-90">
          © <span id="current-year"></span> frani.be
        </p>
        <p class="site-signature">{t(lang, 'footer.signature')}</p>
      </div>
    </footer>

    <script>
      import { initSpotlight } from '../scripts/spotlight';
      initSpotlight();

      document.getElementById('current-year')!.textContent = String(new Date().getFullYear());

      const navToggle = document.getElementById('nav-toggle');
      const navMobile = document.getElementById('nav-mobile');
      const nav = document.getElementById('navigation');
      const ariaOpen = navToggle?.dataset.ariaOpen || 'Open navigation menu';
      const ariaClose = navToggle?.dataset.ariaClose || 'Close navigation menu';
      // Nav transparente en el top; fondo con blur al hacer scroll.
      // Sobre .page-hero (banner púrpura) el texto pasa a blanco para legibilidad.
      const navHasHero = !!document.querySelector('.page-hero');
      const updateNavBg = () => {
        const scrolled = window.scrollY > 24;
        nav?.classList.toggle('nav-scrolled', scrolled);
        nav?.classList.toggle('nav-over-hero', navHasHero && !scrolled);
      };
      updateNavBg();
      window.addEventListener('scroll', updateNavBg, { passive: true });

      const setNavOpen = (open: boolean) => {
        navMobile?.classList.toggle('hidden', !open);
        nav?.classList.toggle('nav-open', open);
        navToggle?.setAttribute('aria-expanded', String(open));
        navToggle?.setAttribute('aria-label', open ? ariaClose : ariaOpen);
        navToggle?.querySelector('.nav-icon-open')?.classList.toggle('hidden', open);
        navToggle?.querySelector('.nav-icon-close')?.classList.toggle('hidden', !open);
      };
      navToggle?.addEventListener('click', () => setNavOpen(navMobile?.classList.contains('hidden') ?? false));
      navMobile?.querySelectorAll('a').forEach(link => {
        link.addEventListener('click', () => setNavOpen(false));
      });
      // Cerrar al hacer click fuera del menú
      document.addEventListener('click', (e) => {
        if (navMobile && !navMobile.classList.contains('hidden') && !(e.target as HTMLElement).closest('#navigation')) {
          setNavOpen(false);
        }
      });
      // Si el viewport crece a desktop con el menú abierto, limpiar estado
      matchMedia('(min-width: 768px)').addEventListener('change', (e) => {
        if (e.matches && navMobile && !navMobile.classList.contains('hidden')) setNavOpen(false);
      });
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && navMobile && !navMobile.classList.contains('hidden')) {
          setNavOpen(false);
          navToggle?.focus();
        }
      });

      // Tema claro/oscuro
      const themeToggle = document.getElementById('theme-toggle');
      const syncThemeIcon = () => {
        const dark = document.documentElement.classList.contains('dark');
        themeToggle?.querySelector('.icon-moon')?.classList.toggle('hidden', dark);
        themeToggle?.querySelector('.icon-sun')?.classList.toggle('hidden', !dark);
        themeToggle?.setAttribute('aria-pressed', String(dark));
        document.querySelector('meta[name="theme-color"]')?.setAttribute('content', dark ? '#17101f' : '#faf8fc');
      };
      syncThemeIcon();
      themeToggle?.addEventListener('click', () => {
        const dark = document.documentElement.classList.toggle('dark');
        localStorage.setItem('theme', dark ? 'dark' : 'light');
        syncThemeIcon();
      });

      // Si el usuario no eligió tema, seguir cambios del sistema en vivo
      matchMedia('(prefers-color-scheme: dark)').addEventListener('change', (e) => {
        if (localStorage.getItem('theme')) return;
        document.documentElement.classList.toggle('dark', e.matches);
        syncThemeIcon();
      });

      // Cambio de idioma: persiste la elección; el link navega a la URL equivalente
      document.querySelectorAll('.lang-opt').forEach(opt => {
        opt.addEventListener('click', () => {
          localStorage.setItem('lang', (opt as HTMLElement).dataset.lang!);
        });
      });
    </script>
  </body>
</html>
