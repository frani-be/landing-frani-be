---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import CtaSection from '../components/CtaSection.astro';
import { localePath, type Lang } from '../i18n/ui';

interface Props { lang: Lang; slug: string; }
const { lang, slug } = Astro.props;

interface Service {
  title: string;
  tagline: string;
  description: string;
  bullets: string[];
  cta: string;
}

const servicesEs: Record<string, Service> = {
  'desarrollo-web': {
    title: 'Desarrollo web',
    tagline: 'Sitios rápidos, accesibles y a medida, sin plantillas genéricas.',
    description: 'Desarrollo sitios que equilibran estética, rendimiento y mantenibilidad: HTML, CSS y JavaScript vainilla cuando la velocidad manda, React, Astro o Next.js cuando la escala lo justifica. WordPress a medida para quienes gestionan su propio contenido.',
    bullets: [
      'Desarrollo pixel-perfect desde Figma o boceto',
      'WordPress a medida (sin page builders pesados)',
      'React, Astro y Next.js para proyectos escalables',
      'Core Web Vitals y rendimiento real en producción',
      'Accesibilidad (WCAG) y SEO técnico incluidos',
      'Entrega con documentación y handoff al equipo',
    ],
    cta: 'Hablemos',
  },
  'diseno-grafico': {
    title: 'Diseño gráfico',
    tagline: 'Identidades visuales que comunican antes de que el usuario lea una palabra.',
    description: 'Tomo la esencia de tu marca y la traduzco a formas, colores y tipografías que funcionan en cualquier contexto. Cada proyecto parte de un brief en profundidad y termina en un sistema de marca que puedes usar de forma autónoma.',
    bullets: [
      'Logotipos y sistemas de identidad visual',
      'Branding para startups y marcas personales',
      'Piezas gráficas para redes sociales y prensa',
      'Diseño editorial (presentaciones, informes, libros)',
      'Guías de marca y manual de uso',
      'Vectorial listo para imprenta y medios digitales',
    ],
    cta: 'Agenda una llamada',
  },
  'estrategia-ux': {
    title: 'Estrategia UX',
    tagline: 'Diseño centrado en la persona, respaldado por evidencia.',
    description: 'Investigar, mapear y validar antes de construir: entrevistas, benchmarks, arquitectura de información, prototipado iterativo y pruebas de usabilidad. El resultado: un producto que la gente entiende y quiere volver a usar.',
    bullets: [
      'Research cualitativo y cuantitativo',
      'Arquetipos de usuario y user journeys',
      'Arquitectura de información y card sorting',
      'Wireframes y prototipos en Figma',
      'Pruebas de usabilidad moderadas y no moderadas',
      'Análisis heurístico y recomendaciones accionables',
    ],
    cta: 'Agenda una consultoría',
  },
  'clases-particulares': {
    title: 'Clases particulares',
    tagline: 'Aprende a tu ritmo con proyectos reales y feedback directo.',
    description: 'Partimos de tus objetivos, tu nivel y tu tiempo disponible. Trabajamos en proyectos concretos (nada de ejercicios abstractos) con retroalimentación honesta en cada sesión.',
    bullets: [
      'HTML, CSS y JavaScript desde cero',
      'Diseño web y UI con Figma',
      'Fundamentos de UX y pensamiento de diseño',
      'React y ecosistema moderno de front-end',
      'WordPress para diseñadores',
      'Sesiones individuales o grupales (hasta 4 personas)',
    ],
    cta: 'Consulta disponibilidad',
  },
};

const servicesEn: Record<string, Service> = {
  'desarrollo-web': {
    title: 'Web development',
    tagline: 'Fast, accessible, custom-built sites, no generic templates.',
    description: 'I build sites that balance aesthetics, performance and maintainability: vanilla HTML, CSS and JavaScript when speed matters, React, Astro or Next.js when scale justifies it. Custom WordPress for clients managing their own content.',
    bullets: [
      'Pixel-perfect development from Figma or sketch',
      'Custom WordPress (no heavy page builders)',
      'React, Astro and Next.js for scalable projects',
      'Core Web Vitals and real production performance',
      'Accessibility (WCAG) and technical SEO included',
      'Delivery with documentation and team handoff',
    ],
    cta: "Let's talk",
  },
  'diseno-grafico': {
    title: 'Graphic design',
    tagline: 'Visual identities that communicate before the user reads a word.',
    description: 'I take the essence of your brand and translate it into shapes, colors and typography that work in any context. Every project starts with an in-depth brief and ends with a brand system you can use autonomously.',
    bullets: [
      'Logos and visual identity systems',
      'Branding for startups and personal brands',
      'Graphic assets for social media and press',
      'Editorial design (presentations, reports, books)',
      'Brand guidelines and usage manual',
      'Vector files ready for print and digital media',
    ],
    cta: 'Book a call',
  },
  'estrategia-ux': {
    title: 'UX strategy',
    tagline: 'People-centered design backed by evidence.',
    description: 'Research, map and validate before building: interviews, benchmarks, information architecture, iterative prototyping and usability testing. The result is a product people understand and want to use again.',
    bullets: [
      'Qualitative and quantitative research',
      'User archetypes and user journeys',
      'Information architecture and card sorting',
      'Wireframes and Figma prototypes',
      'Moderated and unmoderated usability testing',
      'Heuristic analysis and actionable recommendations',
    ],
    cta: 'Book a consultation',
  },
  'clases-particulares': {
    title: 'Private lessons',
    tagline: 'Learn at your own pace with real projects and direct feedback.',
    description: 'We start with your goals, your level and your available time. We work on concrete projects (no abstract exercises) with honest feedback every session.',
    bullets: [
      'HTML, CSS and JavaScript from scratch',
      'Web and UI design with Figma',
      'UX fundamentals and design thinking',
      'React and the modern front-end ecosystem',
      'WordPress for designers',
      'Individual or group sessions (up to 4 people)',
    ],
    cta: 'Check availability',
  },
};

const services = lang === 'en' ? servicesEn : servicesEs;
const service = services[slug];

const copy = {
  es: {
    includes: '¿Qué incluye?',
    howWork: 'Cómo trabajo',
    doubtsTitle: '¿Tienes dudas antes de contratar?',
    doubtsText: 'Llamada de 20 minutos sin compromiso para ver si puedo ayudarte.',
    doubtsCta: 'Agenda la llamada',
    otherService: '¿Buscas otro servicio?',
    allServices: 'Ver todos los servicios',
    bookCall: 'Agendar videollamada',
    servicesPath: 'servicios',
    about: 'Conoce más acerca de',
  },
  en: {
    includes: "What's included?",
    howWork: 'How I work',
    doubtsTitle: 'Questions before hiring?',
    doubtsText: 'A free 20-minute call to see if I can help.',
    doubtsCta: 'Book the call',
    otherService: 'Looking for another service?',
    allServices: 'View all services',
    bookCall: 'Book a video call',
    servicesPath: 'servicios',
    about: 'Learn more about',
  },
}[lang];
---

<BaseLayout
  title={lang === 'en' ? `${service.title} | Frani Medina` : `${service.title} en Chile | Frani Medina`}
  description={`${service.tagline} ${lang === 'en' ? 'Service by Francisca Medina, strategic UX designer and front-end engineer.' : 'Servicio a cargo de Francisca Medina, diseñadora UX estratégica y front-end engineer.'}`}
  lang={lang}
>
  <PageHero
    lang={lang}
    title={`${copy.about} ${service.title}`}
    path={[
      { label: copy.servicesPath, href: localePath('/servicios', lang) },
      { label: slug },
    ]}
    subtitle={service.tagline}
    ctaLabel={service.cta}
    ctaHref="https://calendar.app.google/NjSZEbvWrLfj56wy6"
  />

  <!-- Cuerpo -->
  <section class="section-block-sm bg-surface">
    <div class="container-mid">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-start">
        <div data-reveal>
          <h2 class="text-2xl text-custom-black mb-5">{copy.includes}</h2>
          <ul class="flex flex-col gap-3">
            {service.bullets.map(b => (
              <li class="flex items-start gap-3 text-custom-dark-gray">
                <svg class="icon-stroke w-5 h-5 mt-0.5 flex-shrink-0 text-custom-purple-dark" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <circle cx="12" cy="12" r="9"/><path d="M8.5 12.5l2.5 2.5 4.5-5"/>
                </svg>
                <span>{b}</span>
              </li>
            ))}
          </ul>
        </div>
        <div data-reveal data-reveal-delay="150">
          <h2 class="text-2xl text-custom-black mb-5">{copy.howWork}</h2>
          <p class="text-custom-dark-gray leading-relaxed">{service.description}</p>
          <div class="mt-8 p-6 bg-surface-muted rounded-[var(--radius-card)] border border-border-soft">
            <p class="text-custom-black font-semibold mb-2">{copy.doubtsTitle}</p>
            <p class="text-custom-dark-gray text-sm mb-4">{copy.doubtsText}</p>
            <a
              href="https://calendar.app.google/NjSZEbvWrLfj56wy6"
              target="_blank"
              class="btn btn-primary"
            >{copy.doubtsCta}</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <CtaSection
    title={copy.otherService}
    primaryLabel={copy.allServices}
    primaryHref={localePath('/servicios', lang)}
    secondaryLabel={copy.bookCall}
    secondaryHref="https://calendar.app.google/NjSZEbvWrLfj56wy6"
    bg="bg-custom-light-grey"
    lang={lang}
  />
</BaseLayout>

<script>
  import { initReveal } from '../scripts/reveal';
  initReveal();
</script>
