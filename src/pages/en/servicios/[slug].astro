---
import ServicioDetailView from '../../../views/ServicioDetailView.astro';

export function getStaticPaths() {
  const slugs = ['desarrollo-web', 'estrategia-ux', 'clases-particulares'];
  return slugs.map(slug => ({ params: { slug }, props: { slug } }));
}

const { slug } = Astro.props;
---

<ServicioDetailView lang="en" slug={slug} />
