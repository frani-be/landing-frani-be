        </p>
      </div>
    </div>

    <!-- Scroll button -->
    <div class="text-center mt-16 scroll-btn relative">
      <a
        href="#timeline"
        id="scroll-to-timeline"
        class="text-custom-purple py-3 px-6 cursor-pointer transition-all font-primary font-medium inline-block"
