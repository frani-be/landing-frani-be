---
import SectionTitle from './SectionTitle.astro';
import SocialLinks from './SocialLinks.astro';
---

<section class="section-block contact-section text-white relative overflow-hidden" id="contacto">
  <div class="container-wide relative z-[1]">
    <SectionTitle title="Hablemos" dark={true} class="mb-16" />

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-start max-w-[900px] mx-auto">

      <!-- RRSS + info -->
      <div data-reveal data-reveal-delay="100">
        <p class="text-white/90 text-lg mb-8">¿Tienes un proyecto en mente, quieres contratar un servicio o simplemente saludar? Escríbeme por cualquiera de estos canales.</p>
        <SocialLinks variant="dark" class="flex-col" />
        <div class="mt-10">
          <a
            href="https://calendar.app.google/NjSZEbvWrLfj56wy6"
            target="_blank"
            class="btn btn-white"
          >Agenda una videollamada</a>
        </div>
      </div>

      <!-- Formulario -->
      <form id="contact-form" class="flex flex-col gap-5" novalidate data-reveal data-reveal-delay="250">
        <div>
          <label for="contact-name" class="block text-sm font-semibold mb-1 text-white/90">Nombre</label>
          <input type="text" id="contact-name" name="name" required autocomplete="name"
            class="contact-input" placeholder="Tu nombre" />
        </div>
        <div>
          <label for="contact-email" class="block text-sm font-semibold mb-1 text-white/90">Correo electrónico</label>
          <input type="email" id="contact-email" name="email" required autocomplete="email"
            class="contact-input" placeholder="tu@email.com" />
        </div>
        <div>
          <label for="contact-subject" class="block text-sm font-semibold mb-1 text-white/90">Asunto</label>
          <input type="text" id="contact-subject" name="subject"
            class="contact-input" placeholder="¿En qué te puedo ayudar?" />
        </div>
        <div>
          <label for="contact-message" class="block text-sm font-semibold mb-1 text-white/90">Mensaje</label>
          <textarea id="contact-message" name="message" required rows="5"
            class="contact-input resize-none" placeholder="Cuéntame tu proyecto..."></textarea>
        </div>
        <button type="submit" class="btn btn-white cursor-pointer">
          Enviar mensaje
        </button>
        <p id="form-status" class="text-sm text-center min-h-[1.25em]" role="status" aria-live="polite"></p>
      </form>

    </div>
  </div>
</section>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const status = document.getElementById('form-status') as HTMLElement | null;
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!status) return;
    const btn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
    btn.disabled = true;
    btn.textContent = 'Enviando…';
    status.className = 'text-sm text-center min-h-[1.25em]';
    status.textContent = '';
    const data = new FormData(form);
    try {
      const res = await fetch('https://formspree.io/f/xkoaednq', {
        method: 'POST', body: data, headers: { Accept: 'application/json' },
      });
      if (res.ok) {
        status.textContent = '¡Mensaje enviado! Te respondo a la brevedad.';
        status.classList.add('text-green-200');
        form.reset();
      } else { throw new Error('error'); }
    } catch {
      status.textContent = 'Hubo un error al enviar. Escríbeme directamente a hola@frani.be';
      status.classList.add('text-red-200');
    }
    btn.disabled = false;
    btn.textContent = 'Enviar mensaje';
  });
</script>
