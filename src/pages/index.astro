---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionTitle from '../components/SectionTitle.astro';
import LinksModal from '../components/LinksModal.astro';
import EmbroideryPattern from '../components/EmbroideryPattern.astro';
import { serviceIcons } from '../scripts/serviceIcons';
---

<BaseLayout
  title="Francisca Beatriz Medina Concha | Strategic UX Designer & Front-End Engineer"
  ogUrl="https://frani.be/"
  contactTag="05 / contacto"
>
  <!-- Header / Hero -->
  <header
    class="hero-home pt-40 pb-32 text-center lg:text-left min-h-screen w-screen relative overflow-hidden isolate"
    id="header"
  >
    <div
      class="container-wide flex flex-col lg:flex-row gap-12 items-center relative z-[1]"
      id="header-container"
    >
      <div class="w-full lg:w-3/5">
        <span class="hero-eyebrow" data-reveal data-reveal-delay="50">1 cupo disponible para nuevos proyectos</span>
        <h1 class="mt-6 text-custom-black leading-[0.95]" data-reveal data-reveal-delay="150">
          <span class="block text-[1.05em] lg:text-[1.2em] font-medium">¡Hola! Soy</span>
          <span class="text-gradient block text-[2.4em] lg:text-[3em]">Frani</span>
        </h1>
        <h2 class="text-[1.4em] mt-5" data-reveal data-reveal-delay="450">Strategic UX Designer & Front-End Engineer</h2>
        <p class="text-[1.15em] mt-3 text-custom-dark-gray" data-reveal data-reveal-delay="650">Impulso talento en STEAM y creo tecnología con propósito.</p>
        <div class="flex flex-wrap gap-4 mt-8 justify-center lg:justify-start" data-reveal data-reveal-delay="900">
          <a
            href="https://calendar.app.google/NjSZEbvWrLfj56wy6"
            class="btn btn-primary"
            target="_blank"
          >Agenda una videollamada</a>
          <a
            href="#contacto"
            class="btn btn-secondary"
          >Contáctame</a>
        </div>
      </div>

      <div class="relative flex flex-col gap-6 items-center w-full lg:w-2/5" data-reveal data-reveal-delay="550">
        <EmbroideryPattern class="absolute -top-8 right-0 lg:-right-8 rotate-6" cells={5} />
        <figure class="hero-photo-wrap">
          <img
            src="/images/frani.png"
            alt="Ilustración de Frani programando en su laptop junto a una taza de té"
            id="main-image"
            class="illus-frame"
          />
          <svg class="hero-sparkle" viewBox="0 0 46 46" aria-hidden="true">
            <path d="M11 1l2.8 8.2L22 12l-8.2 2.8L11 23l-2.8-8.2L0 12l8.2-2.8z" fill="#f6a8d8"/>
            <path d="M37 26l1.5 4.4 4.4 1.5-4.4 1.5L37 37.8l-1.5-4.4-4.4-1.5 4.4-1.5z" fill="#8b2db3"/>
          </svg>
        </figure>
        <p id="message">
          <span class="iterate-message text-custom-purple">
            <span>Strategic UX Designer</span>
            <span>Front-End Engineer</span>
            <span>Tech Speaker</span>
            <span>STEAM Advocate</span>
          </span>
        </p>
      </div>
    </div>

    <!-- Scroll button -->
    <div class="text-center mt-16 scroll-btn relative">
      <a
        href="#timeline"
        id="scroll-to-timeline"
        class="text-custom-purple py-3 px-6 cursor-pointer transition-all font-primary font-medium inline-block"
        aria-label="Ir a la sección de trayectoria profesional"
        title="Conoce mi trayectoria profesional"
      >
        <span class="mr-2 text-[1.2em] align-middle" aria-hidden="true">↓</span>
        Ver mi trayectoria
      </a>
    </div>
  </header>

  <!-- Timeline Section -->
  <section class="bg-custom-light-grey section-block border-t border-custom-dark-gray/25" id="timeline">
    <div class="container-wide">
      <SectionTitle title="Últimas 3 experiencias de mi Trayectoria" tag="01 / trayectoria" />

      <div class="flex justify-center gap-2 mb-6 text-center" id="global-controls">
        <button id="expand-all-btn" class="global-control-btn text-xs transition-all font-primary font-medium text-custom-dark-gray border-custom-dark-gray border border-solid bg-white py-0.5 px-3 rounded-full cursor-pointer">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" class="mr-1 inline">
            <path d="M6 9L12 15L18 9" stroke="currentColor" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          Expandir todo
        </button>
        <button id="collapse-all-btn" class="global-control-btn text-xs transition-all font-primary font-medium text-custom-dark-gray border-custom-dark-gray border border-solid bg-white py-0.5 px-3 rounded-full cursor-pointer">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" class="mr-1 inline rotate-180">
            <path d="M6 9L12 15L18 9" stroke="currentColor" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          Colapsar todo
        </button>
      </div>

      <div class="relative max-w-[800px] mx-auto">
        <div id="timeline-container" class="relative"></div>
        <div class="absolute bottom-0 left-0 right-0 h-64 bg-gradient-to-t from-custom-light-grey via-custom-light-grey/80 to-transparent pointer-events-none z-10"></div>
        <div class="relative text-center -mt-12 z-20">
          <a href="/trayectoria" class="btn btn-primary">
            Ver trayectoria completa
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Servicios -->
  <section class="section-block bg-white" id="servicios">
    <div class="container-wide">
      <SectionTitle
        title="Todo lo que puedo hacer por ti"
        subtitle="Diseño, código y estrategia en una sola persona: sin fricción entre etapas ni tres proveedores distintos."
        tag="02 / servicios"
        class="mb-16"
      />

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">

        <article class="service-card" data-reveal data-reveal-delay="0">
          <div class="service-card-icon"><img src={serviceIcons['desarrollo-web']} alt="" /></div>
          <div class="p-6 flex flex-col flex-1">
            <h4 class="text-xl mb-3">Lanza tu sitio web</h4>
            <p class="text-custom-dark-gray text-sm flex-1">Diseño y desarrollo tu sitio completo: rápido, autogestionable y a tu medida. De la idea al aire.</p>
            <a href="/servicios/desarrollo-web" class="btn btn-secondary">Saber más</a>
          </div>
        </article>

        <article class="service-card" data-reveal data-reveal-delay="100">
          <div class="service-card-icon"><img src={serviceIcons['diseno-grafico']} alt="" /></div>
          <div class="p-6 flex flex-col flex-1">
            <h4 class="text-xl mb-3">Haz única tu marca</h4>
            <p class="text-custom-dark-gray text-sm flex-1">Identidad visual completa: logo, paleta y piezas coherentes que comunican lo mismo en todo canal.</p>
            <a href="/servicios/diseno-grafico" class="btn btn-secondary">Saber más</a>
          </div>
        </article>

        <article class="service-card" data-reveal data-reveal-delay="200">
          <div class="service-card-icon"><img src={serviceIcons['estrategia-ux']} alt="" /></div>
          <div class="p-6 flex flex-col flex-1">
            <h4 class="text-xl mb-3">Ordena tu producto</h4>
            <p class="text-custom-dark-gray text-sm flex-1">Auditoría UX basada en evidencia: research, arquitectura, prototipos y tests que hacen fluir a usuarios.</p>
            <a href="/servicios/estrategia-ux" class="btn btn-secondary">Saber más</a>
          </div>
        </article>

        <article class="service-card" data-reveal data-reveal-delay="300">
          <div class="service-card-icon"><img src={serviceIcons['clases-particulares']} alt="" /></div>
          <div class="p-6 flex flex-col flex-1">
            <h4 class="text-xl mb-3">Aprende a tu ritmo</h4>
            <p class="text-custom-dark-gray text-sm flex-1">Clases 1 a 1 de diseño, UX o front-end con proyectos reales y feedback directo en cada sesión.</p>
            <a href="/servicios/clases-particulares" class="btn btn-secondary">Saber más</a>
          </div>
        </article>

      </div>

      <div class="text-center mt-12" data-reveal data-reveal-delay="400">
        <a href="/servicios" class="btn btn-primary">Ver todos los servicios<span class="btn-arrow" aria-hidden="true">↗</span></a>
      </div>
    </div>
  </section>

  <!-- Proyectos Destacados -->
  <section class="section-block bg-custom-light-grey" id="proyectos">
    <div class="container-wide">
      <SectionTitle title="Proyectos que me enorgullecen" tag="03 / proyectos" />

      <div id="featured-projects-container" class="mt-20 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8"></div>

      <div class="text-center mt-12">
        <a href="/proyectos" class="btn btn-primary">
          Ver todos los proyectos<span class="btn-arrow" aria-hidden="true">↗</span>
        </a>
      </div>
    </div>
  </section>

  <!-- Docencia y Comunidad -->
  <section class="section-block-sm bg-white" id="comunidad">
    <div class="container-mid flex flex-col lg:flex-row items-center gap-12 lg:gap-16 text-center lg:text-left">
      <figure class="shrink-0" data-reveal>
        <img
          src="/images/charla.png"
          alt="Ilustración de Frani dando una charla tech desde un atril, con micrófono y credencial"
          class="illus-frame max-w-[300px]"
          loading="lazy"
        />
      </figure>
      <div class="flex-1" data-reveal data-reveal-delay="150">
        <span class="section-tag">04 / comunidad</span>
        <h3 class="text-2xl lg:text-3xl mb-4">Docencia y comunidad</h3>
        <p class="text-custom-dark-gray leading-relaxed">Llevo años en escenarios, bootcamps y comunidades STEAM enseñando diseño y código. El conocimiento también se comparte: por eso doy charlas, mentorías y clases.</p>
        <div class="flex flex-wrap gap-2 mt-6 justify-center lg:justify-start">
          <span class="px-3 py-1 bg-surface-muted text-custom-dark-gray text-sm rounded-full font-medium">Charlas</span>
          <span class="px-3 py-1 bg-surface-muted text-custom-dark-gray text-sm rounded-full font-medium">Mentorías</span>
          <span class="px-3 py-1 bg-surface-muted text-custom-dark-gray text-sm rounded-full font-medium">Comunidad STEAM</span>
        </div>
        <a href="/charlas" class="btn btn-secondary mt-6">Ver videos de charlas<span class="btn-arrow" aria-hidden="true">↗</span></a>
      </div>
    </div>
  </section>

  <LinksModal />
</BaseLayout>

<script>
  import { initReveal } from '../scripts/reveal';
  initReveal();
</script>

<script>
  // Iterate message animation
  const iterateMessage = document.querySelector('.iterate-message');
  if (iterateMessage) {
    const messages = iterateMessage.querySelectorAll('span');
    const messageCount = messages.length;
    const durationPerMessage = 4;
    const totalDuration = messageCount * durationPerMessage;
    messages.forEach((message, index) => {
      const delay = -(messageCount - 1 - index) * durationPerMessage;
      (message as HTMLElement).style.setProperty('--animation-duration', `${totalDuration}s`);
      (message as HTMLElement).style.setProperty('--animation-delay', `${delay}s`);
    });
  }
</script>

<script>
  // Timeline (home preview - 4 items)
  interface TimelineItem {
    id: number;
    title: string;
    company: string;
    location: string;
    startDate: string;
    endDate: string;
    category: string;
    description: string;
  }

  const strokeIcon = (inner: string) =>
    `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="cat-icon" aria-hidden="true">${inner}</svg>`;

  const CATEGORIES: Record<string, { label: string; color: string; icon: string }> = {
    laboral:       { label: 'Profesional', color: '#2555a3', icon: strokeIcon('<rect x="3" y="8" width="18" height="12" rx="2"/><path d="M9 8V6a3 3 0 0 1 6 0v2"/>') },
    academica:     { label: 'Formación',   color: '#9f2eba', icon: strokeIcon('<path d="M2 9.5L12 5l10 4.5-10 4.5z"/><path d="M6 12v4c3 2 9 2 12 0v-4"/>') },
    docencia:      { label: 'Docencia',    color: '#7d1fc7', icon: strokeIcon('<path d="M4 4.5h5a4 4 0 0 1 3 1.7A4 4 0 0 1 15 4.5h5V19h-5a3 3 0 0 0-3 1.5A3 3 0 0 0 9 19H4z"/>') },
    voluntariados: { label: 'Comunidad',   color: '#bd2c97', icon: strokeIcon('<path d="M12 20s-7-4.6-9-9c-1.4-3.2.5-7 4-7 2.4 0 4 1.4 5 2.8C13 5.4 14.6 4 17 4c3.5 0 5.4 3.8 4 7-2 4.4-9 9-9 9z"/>') },
  };

  function formatDate(d: string) {
    if (d === 'actualidad') return 'Actualidad';
    return d.slice(0, 4);
  }

  function processBoldText(text: string) {
    return text.replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>').replace(/__(.*?)__/g, '<strong>$1</strong>');
  }

  function parseMarkdown(text: string) {
    if (!text) return '';
    const lines = text.split('\n');
    let inList = false;
    let result: string[] = [];
    const hasListItems = lines.some(l => l.trim().startsWith('- '));
    for (let i = 0; i < lines.length; i++) {
      const line = lines[i].trim();
      if (line.startsWith('- ')) {
        if (!inList) { result.push('<ul class="timeline-list">'); inList = true; }
        result.push(`<li>${processBoldText(line.substring(2))}</li>`);
      } else {
        if (inList) { result.push('</ul>'); inList = false; }
        if (line) {
          if (hasListItems) {
            result.push(`<p>${processBoldText(line)}</p>`);
          } else {
            if (result.length === 0) result.push('<p>');
            result.push(processBoldText(line));
            if (i < lines.length - 1 && lines[i + 1].trim()) result.push(' ');
          }
        }
      }
    }
    if (inList) result.push('</ul>');
    if (!hasListItems && result.length > 0) result.push('</p>');
    return result.join('');
  }

  function createTimelineItem(item: TimelineItem) {
    const cat = CATEGORIES[item.category] || { label: item.category, color: '#565656', icon: '' };
    const mdHTML = parseMarkdown(item.description);
    return `
      <div class="tl-item opacity-0 transition-all duration-500"
           data-category="${item.category}"
           style="--category-color: ${cat.color}; transform: translateY(20px);">
        <div class="tl-dates">${formatDate(item.startDate)}<span class="tl-sep">–</span>${formatDate(item.endDate)}</div>
        <div class="timeline-content bg-white shadow-sm transition-transform font-primary p-5">
          <button class="timeline-head" aria-expanded="false" aria-controls="description-${item.id}">
            <span class="head-top">
              <span class="timeline-category">${cat.icon}${cat.label}</span>
            </span>
            <span class="head-title">${item.title}</span>
            <span class="head-meta">${item.company} • ${item.location}</span>
            <svg class="head-chevron" width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M6 9L12 15L18 9" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
          <div class="timeline-description collapsed text-custom-black overflow-hidden font-primary leading-relaxed" id="description-${item.id}">${mdHTML}</div>
        </div>
      </div>`;
  }

  function setExpanded(head: HTMLElement, expanded: boolean) {
    const desc = document.getElementById(head.getAttribute('aria-controls') || '');
    if (!desc) return;
    head.setAttribute('aria-expanded', String(expanded));
    desc.classList.toggle('collapsed', !expanded);
    desc.classList.toggle('expanded', expanded);
  }

  async function initTimeline() {
    const res = await fetch('/data/timeline.json');
    const data = await res.json();
    let items: TimelineItem[] = data.timeline || [];

    const isCurrent = (i: TimelineItem) => i.endDate === 'actualidad';
    const byEndDesc = (a: TimelineItem, b: TimelineItem) =>
      new Date(b.endDate + '-01').getTime() - new Date(a.endDate + '-01').getTime();
    const byStartDesc = (a: TimelineItem, b: TimelineItem) =>
      new Date(b.startDate + '-01').getTime() - new Date(a.startDate + '-01').getTime();
    items = [
      ...items.filter(isCurrent).sort(byStartDesc),
      ...items.filter(i => !isCurrent(i)).sort(byEndDesc),
    ].slice(0, 4);

    const container = document.getElementById('timeline-container');
    if (!container) return;
    container.innerHTML = items.map(createTimelineItem).join('');

    setTimeout(() => {
      document.querySelectorAll('.tl-item').forEach((el, i) => {
        setTimeout(() => el.classList.add('animate-in'), i * 100);
      });
    }, 50);

    document.querySelectorAll('.timeline-head').forEach(btn => {
      btn.addEventListener('click', () => {
        setExpanded(btn as HTMLElement, btn.getAttribute('aria-expanded') !== 'true');
      });
    });

    document.getElementById('expand-all-btn')?.addEventListener('click', () => {
      document.querySelectorAll<HTMLElement>('.timeline-head').forEach(h => setExpanded(h, true));
    });
    document.getElementById('collapse-all-btn')?.addEventListener('click', () => {
      document.querySelectorAll<HTMLElement>('.timeline-head').forEach(h => setExpanded(h, false));
    });
  }
  initTimeline();
</script>

<script>
  import { buildProjectCardHTML, extractYear, initLinksModal, revealProjectCards, type Project } from '../scripts/projects';

  async function initProjects() {
    const res = await fetch('/data/projects.json');
    const data = await res.json();
    let projects: Project[] = (data.projects || []).filter((p: Project) => p.featured);
    projects.sort((a, b) => extractYear(b.date ?? '') - extractYear(a.date ?? ''));

    const container = document.getElementById('featured-projects-container');
    if (!container) return;

    container.innerHTML = projects.map(buildProjectCardHTML).join('');
    revealProjectCards();
    initLinksModal(data.projects || []);
  }
  initProjects();
</script>

