---
interface Props {
  variant?: 'light' | 'dark';
  class?: string;
}

const { variant = 'light', class: extraClass = '' } = Astro.props;

const linkClass = variant === 'dark'
  ? 'flex items-center gap-3 text-white font-semibold hover:text-custom-light-purple transition-colors'
  : 'text-sm text-custom-dark-gray border-border-soft border border-solid bg-white py-0.5 px-4 font-bold rounded-full inline-block hover:text-custom-purple hover:border-custom-purple/40';

const iconClass = variant === 'dark' ? 'contact-icon-pill' : '';
---

<ul class:list={['flex flex-wrap gap-4 items-start', extraClass]}>
  <li>
    <a href="mailto:hola@frani.be" class={linkClass} target="_blank" rel="noopener noreferrer">
      {variant === 'dark' && <span class={iconClass}><svg class="inline" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 400 400"><use href="/images/icons.svg#mail"></use></svg></span>}
      {variant === 'light' && <svg class="mr-[0.2rem] mb-[0.2rem] inline" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 400 400"><use href="/images/icons.svg#mail"></use></svg>}
      {variant === 'dark' ? 'hola@frani.be' : 'Mail'}
    </a>
  </li>
  <li>
    <a href="https://www.linkedin.com/in/frani-be/" class={linkClass} target="_blank" rel="noopener noreferrer">
      {variant === 'dark' && <span class={iconClass}><svg class="inline" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 400 400"><use href="/images/icons.svg#linkedin"></use></svg></span>}
      {variant === 'light' && <svg class="mr-[0.2rem] mb-[0.2rem] inline" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 400 400"><use href="/images/icons.svg#linkedin"></use></svg>}
      LinkedIn
    </a>
  </li>
  <li>
    <a href="https://github.com/frani-be" class={linkClass} target="_blank" rel="noopener noreferrer">
      {variant === 'dark' && <span class={iconClass}><svg class="inline" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 400 400"><use href="/images/icons.svg#github"></use></svg></span>}
      {variant === 'light' && <svg class="mr-[0.2rem] mb-[0.2rem] inline" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 400 400"><use href="/images/icons.svg#github"></use></svg>}
      GitHub
    </a>
  </li>
  <li>
    <a href="https://www.instagram.com/frani.be/" class={linkClass} target="_blank" rel="noopener noreferrer">
      {variant === 'dark' && <span class={iconClass}><svg class="inline" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 400 400"><use href="/images/icons.svg#instagram"></use></svg></span>}
      {variant === 'light' && <svg class="mr-[0.2rem] mb-[0.2rem] inline" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 400 400"><use href="/images/icons.svg#instagram"></use></svg>}
      Instagram
    </a>
  </li>
</ul>
