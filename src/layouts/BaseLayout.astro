---
import '../styles/global.css';
import ContactSection from '../components/ContactSection.astro';
import EmbroideryPattern from '../components/EmbroideryPattern.astro';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  ogUrl?: string;
  contactTag?: string;
}

const {
  title,
  description = 'Portafolio de Francisca Beatriz Medina Concha. Impulso talento en STEAM y creo tecnología con propósito.',
  ogImage = 'https://frani.be/images/logo.jpg',
  ogUrl = 'https://frani.be/',
  contactTag,
} = Astro.props;
---

<!doctype html>
<html lang="es" class="overflow-x-hidden">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="author" content="Francisca Beatriz Medina Concha" />
    <meta name="description" content={description} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={ogUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={ogUrl} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Favicons -->
    <link href="/favicons/apple-touch-icon-76x76.png" rel="apple-touch-icon" sizes="76x76" />
    <link href="/favicons/apple-touch-icon-120x120.png" rel="apple-touch-icon" sizes="120x120" />
    <link href="/favicons/apple-touch-icon-152x152.png" rel="apple-touch-icon" sizes="152x152" />
    <link href="/favicons/apple-touch-icon-180x180.png" rel="apple-touch-icon" sizes="180x180" />
    <link href="/favicons/icon-hires.png" rel="icon" sizes="192x192" />
    <link href="/favicons/icon-normal.png" rel="icon" sizes="128x128" />
    <link href="/favicons/icon.svg" rel="mask-icon" sizes="any" />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,100..1000;1,9..40,100..1000&family=JetBrains+Mono:wght@400;500&family=Space+Grotesk:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <slot name="head" />
  </head>

  <body class="overflow-x-hidden font-primary font-light text-custom-black text-base lg:text-lg">
    <!-- Navigation -->
    <nav class="fixed top-0 left-1/2 -translate-x-1/2 w-full py-4 pb-6 z-[3] overflow-visible" id="navigation">
      <div class="w-full px-8 mx-auto max-w-[540px] sm:max-w-[722px] md:max-w-[900px] lg:max-w-[1220px] xl:max-w-[1380px] flex items-center justify-between gap-6">
        <div class="logo-container">
          <a href="/" aria-label="Ir al inicio">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 300 70.3">
              <use href="/images/icons.svg#logo"></use>
            </svg>
          </a>
        </div>
        <div class="hidden md:flex items-center gap-1">
          <a href="/trayectoria" class="nav-link">Trayectoria</a>
          <a href="/servicios" class="nav-link">Servicios</a>
          <a href="/proyectos" class="nav-link">Proyectos</a>
          <a href="#contacto" class="btn btn-primary ml-2" style="padding:0.55rem 1.4rem">Contacto</a>
        </div>
      </div>
    </nav>

    <slot />

    <ContactSection tag={contactTag} />

    <!-- Footer -->
    <footer class="py-8 bg-gradient-footer text-white relative overflow-hidden">
      <div class="container-wide text-center relative z-[1]">
        <EmbroideryPattern class="embroidery--light mx-auto mb-5" cells={4} />
        <p class="text-[0.75em] opacity-90">
          © <span id="current-year"></span> frani.be
        </p>
        <p class="site-signature">// hecho con código, curiosidad y té</p>
      </div>
    </footer>

    <script>
      document.getElementById('current-year')!.textContent = String(new Date().getFullYear());
    </script>
  </body>
</html>
