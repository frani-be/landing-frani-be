---
interface Props {
  title: string;
  ghost?: string;
  class?: string;
  reveal?: boolean;
  dark?: boolean;
}

const {
  title,
  ghost = title,
  class: extraClass = '',
  reveal = true,
  dark = false,
} = Astro.props;
---

<div
  class:list={['section-title-wrapper', extraClass]}
  data-reveal={reveal || undefined}
>
  <span
    class:list={['section-title-ghost', dark && '!text-white/20']}
    aria-hidden="true"
    role="presentation"
  >{ghost}</span>
  <h3 class:list={['section-title-front', dark && '!text-white']}>{title}</h3>
</div>
