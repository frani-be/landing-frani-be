---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Francisca Beatriz Medina Concha | Strategic UX Designer & Front-End Engineer"
  ogUrl="https://frani.be/"
>
  <!-- Header / Hero -->
  <header
    class="bg-gradient-to-br from-custom-light-grey via-custom-light-grey to-custom-purple pt-40 pb-40 glitter-container text-center lg:text-left min-h-screen w-screen relative overflow-hidden isolate"
    id="header"
  >
    <div
      class="w-full px-8 mx-auto max-w-[540px] sm:max-w-[722px] md:max-w-[900px] lg:max-w-[1220px] xl:max-w-[1380px] flex flex-col lg:flex-row gap-8 items-center relative z-[1]"
      id="header-container"
    >
      <div class="w-full lg:w-3/4">
        <h1 class="text-[4em] lg:text-[5em] leading-[0.9] text-custom-black" data-reveal data-reveal-delay="100">
          Francisca Beatriz<br />
          <span class="text-custom-purple">Medina Concha</span>
        </h1>
        <h2 class="text-[1.4em] mt-5 font-bold" data-reveal data-reveal-delay="450">Strategic UX Designer & Front-End Engineer</h2>
        <p class="text-[1.15em] mt-3 text-custom-dark-gray" data-reveal data-reveal-delay="650">Impulso talento en STEAM y creo tecnología con propósito.</p>
        <div class="flex flex-wrap gap-4 mt-8 justify-center lg:justify-start" data-reveal data-reveal-delay="900">
          <a
            href="https://calendar.app.google/NjSZEbvWrLfj56wy6"
            class="bg-custom-purple text-white py-2 px-7 font-bold rounded-[7px] inline-block text-base"
            target="_blank"
          >Agenda una videollamada</a>
          <a
            href="#contacto"
            class="text-custom-purple border-custom-purple border border-solid bg-white py-2 px-7 font-bold rounded-[7px] inline-block text-base"
          >Contáctame</a>
        </div>
      </div>

      <div class="flex flex-col gap-6 items-center w-full lg:w-1/2" data-reveal data-reveal-delay="550">
        <figure>
          <img
            src="/images/image_frani-1.png"
            alt="Francisca Beatriz Medina Concha"
            id="main-image"
            class="fade-effect transition-opacity duration-500 opacity-100"
          />
        </figure>
        <noscript>
          <img src="/images/image_frani-1.png" alt="Francisca Beatriz Medina Concha" />
          <img src="/images/image_frani-2.png" alt="Francisca Beatriz Medina Concha" />
          <img src="/images/image_frani-3.png" alt="Francisca Beatriz Medina Concha" />
          <img src="/images/image_frani-4.png" alt="Francisca Beatriz Medina Concha" />
          <img src="/images/image_frani-5.png" alt="Francisca Beatriz Medina Concha" />
          <img src="/images/image_frani-6.png" alt="Francisca Beatriz Medina Concha" />
          <img src="/images/image_frani-7.png" alt="Francisca Beatriz Medina Concha" />
          <img src="/images/image_frani-8.png" alt="Francisca Beatriz Medina Concha" />
          <img src="/images/image_frani-9.png" alt="Francisca Beatriz Medina Concha" />
        </noscript>
        <p id="message">
          <span class="static-message">Soy Francisca Beatriz,</span>
          <span class="iterate-message text-custom-purple">
            <span>Strategic UX Designer</span>
            <span>Front-End Engineer</span>
            <span>Tech Speaker</span>
            <span>STEAM Advocate</span>
