---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionTitle from '../components/SectionTitle.astro';
import SocialLinks from '../components/SocialLinks.astro';
import LinksModal from '../components/LinksModal.astro';
import ContactSection from '../components/ContactSection.astro';
---

<BaseLayout
  title="Francisca Beatriz Medina Concha | Strategic UX Designer & Front-End Engineer"
  ogUrl="https://frani.be/"
>
  <!-- Header / Hero -->
  <header
    class="hero-home pt-40 pb-32 text-center lg:text-left min-h-screen w-screen relative overflow-hidden isolate"
    id="header"
  >
    <div
      class="container-wide flex flex-col lg:flex-row gap-12 items-center relative z-[1]"
      id="header-container"
    >
      <div class="w-full lg:w-3/5">
        <span class="hero-eyebrow" data-reveal data-reveal-delay="50">Disponible para nuevos proyectos</span>
        <h1 class="text-[3.4em] lg:text-[4.6em] leading-[0.95] mt-6 text-custom-black" data-reveal data-reveal-delay="150">
          Francisca Beatriz<br />
          <span class="text-gradient">Medina Concha</span>
        </h1>
        <h2 class="text-[1.4em] mt-5 font-semibold" data-reveal data-reveal-delay="450">Strategic UX Designer & Front-End Engineer</h2>
        <p class="text-[1.15em] mt-3 text-custom-dark-gray" data-reveal data-reveal-delay="650">Impulso talento en STEAM y creo tecnología con propósito.</p>
        <div class="flex flex-wrap gap-4 mt-8 justify-center lg:justify-start" data-reveal data-reveal-delay="900">
          <a
            href="https://calendar.app.google/NjSZEbvWrLfj56wy6"
            class="btn btn-primary"
            target="_blank"
          >Agenda una videollamada</a>
          <a
            href="#contacto"
            class="btn btn-secondary"
          >Contáctame</a>
        </div>
      </div>

      <div class="flex flex-col gap-6 items-center w-full lg:w-2/5" data-reveal data-reveal-delay="550">
        <figure class="hero-photo-wrap">
          <img
            src="/images/image_frani-1.png"
            alt="Francisca Beatriz Medina Concha"
            id="main-image"
            class="fade-effect transition-opacity duration-500 opacity-100"
          />
        </figure>
        <noscript>
          <img src="/images/image_frani-1.png" alt="Francisca Beatriz Medina Concha" />
          <img src="/images/image_frani-2.png" alt="Francisca Beatriz Medina Concha" />
          <img src="/images/image_frani-3.png" alt="Francisca Beatriz Medina Concha" />
          <img src="/images/image_frani-4.png" alt="Francisca Beatriz Medina Concha" />
          <img src="/images/image_frani-5.png" alt="Francisca Beatriz Medina Concha" />
          <img src="/images/image_frani-6.png" alt="Francisca Beatriz Medina Concha" />
          <img src="/images/image_frani-7.png" alt="Francisca Beatriz Medina Concha" />
          <img src="/images/image_frani-8.png" alt="Francisca Beatriz Medina Concha" />
          <img src="/images/image_frani-9.png" alt="Francisca Beatriz Medina Concha" />
        </noscript>
        <p id="message">
          <span class="static-message">Soy Francisca Beatriz,</span>
          <span class="iterate-message text-custom-purple">
            <span>Strategic UX Designer</span>
            <span>Front-End Engineer</span>
            <span>Tech Speaker</span>
            <span>STEAM Advocate</span>
          </span>
        </p>
      </div>
    </div>

    <!-- Scroll button -->
    <div class="text-center mt-16 scroll-btn relative">
      <a
        href="#timeline"
        id="scroll-to-timeline"
        class="text-custom-purple py-3 px-6 cursor-pointer transition-all font-primary font-medium inline-block"
        aria-label="Ir a la sección de trayectoria profesional"
        title="Conoce mi trayectoria profesional"
      >
        <span class="mr-2 text-[1.2em] align-middle" aria-hidden="true">↓</span>
        Ver mi trayectoria
      </a>
    </div>
  </header>

  <!-- Timeline Section -->
  <section class="bg-custom-light-grey section-block border-t border-custom-dark-gray/25" id="timeline">
    <div class="container-wide">
      <SectionTitle title="Últimas 3 experiencias de mi Trayectoria" ghost="Trayectoria" />

      <div class="flex justify-center gap-2 mb-6 text-center" id="global-controls">
        <button id="expand-all-btn" class="global-control-btn text-xs transition-all font-primary font-medium text-custom-dark-gray border-custom-dark-gray border border-solid bg-white py-0.5 px-3 rounded-[7px] cursor-pointer">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" class="mr-1 inline">
            <path d="M6 9L12 15L18 9" stroke="currentColor" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          Expandir todo
        </button>
        <button id="collapse-all-btn" class="global-control-btn text-xs transition-all font-primary font-medium text-custom-dark-gray border-custom-dark-gray border border-solid bg-white py-0.5 px-3 rounded-[7px] cursor-pointer">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" class="mr-1 inline rotate-180">
            <path d="M6 9L12 15L18 9" stroke="currentColor" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          Colapsar todo
        </button>
      </div>

      <div class="relative max-w-[800px] mx-auto">
        <div id="timeline-container" class="relative"></div>
        <div class="absolute bottom-0 left-0 right-0 h-64 bg-gradient-to-t from-custom-light-grey via-custom-light-grey/80 to-transparent pointer-events-none z-10"></div>
        <div class="relative text-center -mt-12 z-20">
          <a href="/trayectoria" class="btn btn-primary">
            Ver trayectoria completa
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Servicios -->
  <section class="section-block bg-white" id="servicios">
    <div class="container-wide">
      <SectionTitle title="Todo lo que puedo hacer por ti" ghost="Servicios" class="mb-16" />

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">

        <article class="service-card" data-reveal data-reveal-delay="0">
          <div class="service-card-icon">
            <svg viewBox="0 0 24 24" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>
          </div>
          <div class="p-6 flex flex-col flex-1">
            <h4 class="text-xl font-bold text-custom-purple mb-3">Desarrollo web</h4>
            <p class="text-custom-dark-gray text-sm flex-1">Sitios y aplicaciones a medida, desde el diseño hasta el deploy. HTML, CSS, JS, WordPress y frameworks modernos.</p>
            <a href="/servicios/desarrollo-web" class="btn btn-secondary">Saber más</a>
          </div>
        </article>

        <article class="service-card" data-reveal data-reveal-delay="100">
          <div class="service-card-icon">
            <svg viewBox="0 0 24 24" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 19l7-7 3 3-7 7-3-3z"/><path d="M18 13l-1.5-7.5L2 2l3.5 14.5L13 18l5-5z"/><path d="M2 2l7.586 7.586"/><circle cx="11" cy="11" r="2"/></svg>
          </div>
          <div class="p-6 flex flex-col flex-1">
            <h4 class="text-xl font-bold text-custom-purple mb-3">Diseño gráfico</h4>
            <p class="text-custom-dark-gray text-sm flex-1">Identidad visual, logotipos y piezas gráficas con síntesis y coherencia de marca. Del brief al arte final.</p>
            <a href="/servicios/diseno-grafico" class="btn btn-secondary">Saber más</a>
          </div>
        </article>

        <article class="service-card" data-reveal data-reveal-delay="200">
          <div class="service-card-icon">
            <svg viewBox="0 0 24 24" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="6"/><circle cx="12" cy="12" r="2"/></svg>
          </div>
          <div class="p-6 flex flex-col flex-1">
            <h4 class="text-xl font-bold text-custom-purple mb-3">Estrategia UX</h4>
            <p class="text-custom-dark-gray text-sm flex-1">Research, arquitectura de información, prototipos y pruebas de usabilidad para tomar decisiones basadas en evidencia.</p>
            <a href="/servicios/estrategia-ux" class="btn btn-secondary">Saber más</a>
          </div>
        </article>

        <article class="service-card" data-reveal data-reveal-delay="300">
          <div class="service-card-icon">
            <svg viewBox="0 0 24 24" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
          </div>
          <div class="p-6 flex flex-col flex-1">
            <h4 class="text-xl font-bold text-custom-purple mb-3">Clases particulares</h4>
            <p class="text-custom-dark-gray text-sm flex-1">Aprende diseño web, UX o programación front-end a tu ritmo. Clases personalizadas con proyectos reales y feedback directo.</p>
            <a href="/servicios/clases-particulares" class="btn btn-secondary">Saber más</a>
          </div>
        </article>

      </div>

      <div class="text-center mt-12" data-reveal data-reveal-delay="400">
        <a href="/servicios" class="btn btn-primary">Ver todos los servicios</a>
      </div>
    </div>
  </section>

  <!-- Proyectos Destacados -->
  <section class="section-block bg-custom-light-grey" id="proyectos">
    <div class="container-wide">
      <SectionTitle title="Proyectos que me enorgullecen" ghost="Proyectos" />

      <div id="featured-projects-container" class="mt-20 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8"></div>

      <div class="text-center mt-12">
        <a href="/proyectos" class="btn btn-primary">
          Ver todos los proyectos
        </a>
      </div>
    </div>
  </section>

  <LinksModal />
</BaseLayout>

<script>
  import { initReveal } from '../scripts/reveal';
  initReveal();
</script>

<script>
  // Image transition
  let counter = 1;
  const cantImages = 9;
  const duration = 13000;
  const initialDelay = 2000;
  const fadeDuration = 500;
  const mainImage = document.getElementById('main-image') as HTMLImageElement | null;

  if (mainImage) {
    mainImage.style.opacity = '1';
    function changeImage() {
      counter = counter % cantImages + 1;
      mainImage!.style.opacity = '0';
      setTimeout(() => {
        mainImage!.src = `/images/image_frani-${counter}.png`;
        mainImage!.style.opacity = '1';
      }, fadeDuration);
    }
    setTimeout(() => {
      changeImage();
      setInterval(changeImage, duration);
    }, duration - initialDelay);
  }

  // Iterate message animation
  const iterateMessage = document.querySelector('.iterate-message');
  if (iterateMessage) {
    const messages = iterateMessage.querySelectorAll('span');
    const messageCount = messages.length;
    const durationPerMessage = 4;
    const totalDuration = messageCount * durationPerMessage;
    messages.forEach((message, index) => {
      const delay = -(messageCount - 1 - index) * durationPerMessage;
      (message as HTMLElement).style.setProperty('--animation-duration', `${totalDuration}s`);
      (message as HTMLElement).style.setProperty('--animation-delay', `${delay}s`);
    });
  }
</script>

<script>
  // Timeline (home preview - 4 items)
  interface TimelineItem {
    id: number;
    title: string;
    company: string;
    location: string;
    startDate: string;
    endDate: string;
    category: string;
    description: string;
  }

  const CATEGORIES: Record<string, { label: string; color: string }> = {
    laboral:       { label: 'Experiencia laboral',       color: '#2555a3' },
    academica:     { label: 'Formación académica',        color: '#9f2eba' },
    docencia:      { label: 'Experiencia en docencia',    color: '#7d1fc7' },
    voluntariados: { label: 'Voluntariados',              color: '#bd2c97' },
  };
  const MONTHS = ['Ene','Feb','Mar','Abr','May','Jun','Jul','Ago','Sep','Oct','Nov','Dic'];

  function formatDate(d: string) {
    if (d === 'actualidad') return 'Actualidad';
    const [year, month] = d.split('-');
    return `${MONTHS[parseInt(month) - 1]} ${year}`;
  }

  function processBoldText(text: string) {
    return text.replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>').replace(/__(.*?)__/g, '<strong>$1</strong>');
  }

  function parseMarkdown(text: string) {
    if (!text) return '';
    const lines = text.split('\n');
    let inList = false;
    let result: string[] = [];
    const hasListItems = lines.some(l => l.trim().startsWith('- '));
    for (let i = 0; i < lines.length; i++) {
      const line = lines[i].trim();
      if (line.startsWith('- ')) {
        if (!inList) { result.push('<ul class="timeline-list">'); inList = true; }
        result.push(`<li>${processBoldText(line.substring(2))}</li>`);
      } else {
        if (inList) { result.push('</ul>'); inList = false; }
        if (line) {
          if (hasListItems) {
            result.push(`<p>${processBoldText(line)}</p>`);
          } else {
            if (result.length === 0) result.push('<p>');
            result.push(processBoldText(line));
            if (i < lines.length - 1 && lines[i + 1].trim()) result.push(' ');
          }
        }
      }
    }
    if (inList) result.push('</ul>');
    if (!hasListItems && result.length > 0) result.push('</p>');
    return result.join('');
  }

  function createTimelineItem(item: TimelineItem) {
    const cat = CATEGORIES[item.category] || { label: item.category, color: '#565656' };
    const mdHTML = parseMarkdown(item.description);
    return `
      <div class="relative mb-8 opacity-0 transition-all duration-500 timeline-item ml-16"
           data-category="${item.category}"
           style="--category-color: ${cat.color}; transform: translateY(20px);">
        <div class="timeline-marker absolute rounded-full z-[2] w-4 h-4" style="left:-4rem;top:0.75rem;margin-left:1.5rem;"></div>
        <div class="timeline-content bg-white rounded-[10px] shadow-sm transition-transform font-primary p-6">
          <div class="flex justify-between items-center flex-wrap timeline-header-content mb-2 gap-2">
            <div class="text-[0.75em] text-custom-dark-gray font-medium font-primary">${formatDate(item.startDate)} - ${formatDate(item.endDate)}</div>
            <button class="timeline-category text-white text-sm transition-all font-primary font-medium border border-solid py-0.5 px-5 rounded-full"
                    style="border-color:${cat.color};">${cat.label}</button>
          </div>
          <h3 class="text-[1.25em] font-bold text-custom-black m-0 font-titles mb-2 leading-tight">${item.title}</h3>
          <div class="text-base text-custom-dark-gray font-medium font-primary mb-4">${item.company} • ${item.location}</div>
          <div class="relative">
            <div class="timeline-description collapsed text-custom-black overflow-hidden font-primary leading-relaxed" id="description-${item.id}">${mdHTML}</div>
            <button class="timeline-toggle font-semibold text-[0.75em] cursor-pointer flex items-center transition-all font-primary gap-1 mt-2 bg-transparent border-none" data-item-id="${item.id}">
              <span class="toggle-text">Ver más</span>
              <svg class="toggle-icon" width="16" height="16" viewBox="0 0 24 24" fill="none">
                <path d="M6 9L12 15L18 9" stroke="currentColor" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </button>
          </div>
        </div>
      </div>`;
  }

  async function initTimeline() {
    const res = await fetch('/data/timeline.json');
    const data = await res.json();
    let items: TimelineItem[] = data.timeline || [];
    items.sort((a, b) => new Date(b.startDate + '-01').getTime() - new Date(a.startDate + '-01').getTime());
    items = items.slice(0, 4);

    const container = document.getElementById('timeline-container');
    if (!container) return;
    container.innerHTML = `<div class="timeline-line absolute left-8 top-0 bottom-0 w-0.5 md:left-8"></div>${items.map(createTimelineItem).join('')}`;

    setTimeout(() => {
      document.querySelectorAll('.timeline-item').forEach((el, i) => {
        setTimeout(() => el.classList.add('animate-in'), i * 100);
      });
    }, 50);

    document.querySelectorAll('.timeline-toggle').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const id = (e.currentTarget as HTMLElement).getAttribute('data-item-id');
        const desc = document.getElementById(`description-${id}`);
        if (!desc) return;
        const btn = desc.nextElementSibling as HTMLElement;
        const txt = btn.querySelector('.toggle-text') as HTMLElement;
        const ico = btn.querySelector('.toggle-icon') as HTMLElement;
        if (desc.classList.contains('collapsed')) {
          desc.classList.replace('collapsed', 'expanded');
          txt.textContent = 'Ver menos';
          ico.style.transform = 'rotate(180deg)';
        } else {
          desc.classList.replace('expanded', 'collapsed');
          txt.textContent = 'Ver más';
          ico.style.transform = 'rotate(0deg)';
        }
      });
    });

    document.getElementById('expand-all-btn')?.addEventListener('click', () => {
      document.querySelectorAll('.timeline-description.collapsed').forEach(desc => {
        desc.classList.replace('collapsed', 'expanded');
        const btn = desc.nextElementSibling as HTMLElement;
        (btn.querySelector('.toggle-text') as HTMLElement).textContent = 'Ver menos';
        (btn.querySelector('.toggle-icon') as HTMLElement).style.transform = 'rotate(180deg)';
      });
    });
    document.getElementById('collapse-all-btn')?.addEventListener('click', () => {
      document.querySelectorAll('.timeline-description.expanded').forEach(desc => {
        desc.classList.replace('expanded', 'collapsed');
        const btn = desc.nextElementSibling as HTMLElement;
        (btn.querySelector('.toggle-text') as HTMLElement).textContent = 'Ver más';
        (btn.querySelector('.toggle-icon') as HTMLElement).style.transform = 'rotate(0deg)';
      });
    });
  }
  initTimeline();
</script>

<script>
  import { buildProjectCardHTML, extractYear, initLinksModal, revealProjectCards, type Project } from '../scripts/projects';

  async function initProjects() {
    const res = await fetch('/data/projects.json');
    const data = await res.json();
    let projects: Project[] = (data.projects || []).filter((p: Project) => p.featured);
    projects.sort((a, b) => extractYear(b.date ?? '') - extractYear(a.date ?? ''));

    const container = document.getElementById('featured-projects-container');
    if (!container) return;

    container.innerHTML = projects.map(buildProjectCardHTML).join('');
    revealProjectCards();
    initLinksModal(data.projects || []);
  }
  initProjects();
</script>

